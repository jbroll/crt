#!/bin/sh
# Mock curl: canned token and manifest, and the fixed fixture layer for blobs.
# CRT_MOCK_CURL_LOG: append a line per blob fetch.
# CRT_MOCK_BAD_BLOB=1: serve a blob whose content does not match its digest.
FIXTURES="$(cd "$(dirname "$0")/../fixtures" && pwd)"
url=""
outfile=""
while [ $# -gt 0 ]; do
    case "$1" in
        -o) outfile="$2"; shift 2 ;;
        http*) url="$1"; shift ;;
        *) shift ;;
    esac
done
case "$url" in
    *auth*|*token*) printf '{"token":"mock-token"}\n' ;;
    */manifests/*) cat "$FIXTURES/manifest.json" ;;
    */blobs/*)
        [ -n "$CRT_MOCK_CURL_LOG" ] && echo blob >> "$CRT_MOCK_CURL_LOG"
        if [ -n "$CRT_MOCK_BAD_BLOB" ]; then
            src=$(mktemp); printf 'tampered\n' > "$src"
        else
            src="$FIXTURES/layer.tar.gz"
        fi
        if [ -n "$outfile" ]; then cp "$src" "$outfile"; else cat "$src"; fi
        [ -n "$CRT_MOCK_BAD_BLOB" ] && rm -f "$src"
        ;;
    *) printf 'mock-curl: unhandled url: %s\n' "$url" >&2; exit 1 ;;
esac
exit 0
