#!/bin/bash
# crt - minimal chroot manager
#
# Usage:
#   crt create <name>               # Bootstrap Void Linux rootfs via xbps
#   crt create <name> [image]       # Pull rootfs from OCI registry
#   crt enter <name>                # Interactive shell
#   crt run <name> <cmd> [args...]  # Run command (isolated via unshare+chroot)
#   crt list                        # List chroots
#   crt rm <name>                   # Remove chroot
#   crt export <name> <binary>      # Create host wrapper for binary
#   crt install [--prefix DIR]      # Install to DIR/bin/crt (root), default /data/crt
#   crt setup [--prefix DIR] [user...]  # Delegate cgroup, make DIR/home/<user> (root)
#   crt doctor [--limits]           # Check readiness for hardened runs
#   crt home                        # Print the resolved CRT_HOME
#   crt cgroup-exec <user> [--leaf NAME] -- cmd...  # (root) Start cmd in user-<uid>/NAME

set -e

# Drop any shell functions the caller exported into our environment (bash
# exports them as BASH_FUNC_* env vars and auto-imports them). Otherwise a
# caller function named like a command crt runs (mount, unshare, ...) would
# shadow the real binary. Clear the inherited function table before we define
# our own, and strip the BASH_FUNC_* / BASH_ENV carriers so children are clean.
_crt_inherited_fns=$(compgen -A function 2>/dev/null || true)
# shellcheck disable=SC2086  # deliberate word split: one function name per word
[ -n "$_crt_inherited_fns" ] && unset -f $_crt_inherited_fns 2>/dev/null || true
unset _crt_inherited_fns
for _v in $(compgen -e 2>/dev/null); do
    case "$_v" in BASH_FUNC_*|BASH_ENV) unset "$_v" 2>/dev/null || true ;; esac
done
unset _v

readonly CRT_TRUSTED_PATH=/usr/bin:/bin:/usr/sbin:/sbin
readonly CRT_DEFAULT_HOME=/home/crt

# resolve_crt_home — CRT_HOME is $CRT_HOME if set, else <prefix>/home/<user>
# if that directory exists, else /home/crt. CRT_BIN defaults to $CRT_HOME/bin
# under the /data layout and to /home/crt/bin otherwise (as before the layout).
resolve_crt_home() {
    local user layout=0
    if [ -n "${CRT_HOME:-}" ]; then
        CRT_HOME_FROM="\$CRT_HOME"
    else
        user=$(id -un 2>/dev/null) || user=""
        if [ -n "$user" ] && [ -d "$CRT_DATA_PREFIX/home/$user" ]; then
            CRT_HOME="$CRT_DATA_PREFIX/home/$user"
            CRT_HOME_FROM="$CRT_DATA_PREFIX/home/<user>"
            layout=1
        else
            CRT_HOME=$CRT_DEFAULT_HOME
            CRT_HOME_FROM="the default"
        fi
    fi
    if [ -z "${CRT_BIN:-}" ]; then
        if [ "$layout" = 1 ]; then CRT_BIN="$CRT_HOME/bin"; else CRT_BIN="$CRT_DEFAULT_HOME/bin"; fi
    fi
    # Per-rootfs stored config and state live OUTSIDE every rootfs, so a container
    # can neither read nor rewrite the config that governs its own (or a later) run.
    CRT_CONF_DIR="$CRT_HOME/.config"
    CRT_STATE_DIR="$CRT_HOME/.state"
}

# Rootfs names are single path components: letters, digits, '.', '_', '-',
# starting with a letter or digit. This rules out '/', '..', a trailing slash
# and other aliases that would name the same rootfs under a different key.
validate_name() {
    if ! [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        echo "Error: invalid name '$1' (use letters, digits, '.', '_', '-';" \
             "start with a letter or digit; no '/')" >&2
        exit 1
    fi
}

# rootfs_identity DIR — "dev:inode canonical-path" of an existing rootfs dir.
rootfs_identity() {
    local p id
    p=$(realpath -e -- "$1" 2>/dev/null) || return 1
    id=$(stat -c '%d:%i' -- "$p" 2>/dev/null) || return 1
    printf '%s %s\n' "$id" "$p"
}

# The pristine marker says "this rootfs is exactly what crt create wrote and has
# not been run writable since". crt create writes it; hardened runs require it;
# every non-hardened run deletes it first. It records the rootfs identity, so a
# renamed, re-created, aliased or foreign rootfs never matches a stale marker,
# and a rootfs with no marker (including legacy ones) is not pristine.
pristine_marker() { printf '%s\n' "$CRT_STATE_DIR/$1.pristine"; }

mark_pristine() {  # name rootfs
    local m id
    m=$(pristine_marker "$1")
    id=$(rootfs_identity "$2") || return 1
    mkdir -p "$CRT_STATE_DIR" || return 1
    printf '%s\n' "$id" > "$m.tmp" && mv -f -- "$m.tmp" "$m"
}

is_pristine() {  # name rootfs
    local m id want
    m=$(pristine_marker "$1")
    [ -f "$m" ] && [ ! -L "$m" ] || return 1
    id=$(rootfs_identity "$2") || return 1
    IFS= read -r want < "$m" || return 1
    [ "$want" = "$id" ]
}

clear_pristine() {  # name — fail if the marker cannot be removed
    local m
    m=$(pristine_marker "$1")
    rm -f -- "$m" 2>/dev/null
    [ ! -e "$m" ] && [ ! -L "$m" ]
}

# _paths_overlap A B — true when one canonical path is at or under the other.
_paths_overlap() {
    local a="$1" b="$2"
    if [ "$a" = / ] || [ "$b" = / ] || [ "$a" = "$b" ]; then return 0; fi
    case "$a" in "$b"/*) return 0 ;; esac
    case "$b" in "$a"/*) return 0 ;; esac
    return 1
}

# Hardened guarantees rely on no container being able to reach CRT_HOME (rootfs
# trees, .config, .state). A non-hardened run binds $HOME, /tmp and the host side
# of any mount line in any stored config, so CRT_HOME must not overlap those.
crt_home_exposures() {  # prints "canonical-path|label" per bindable path
    local p cfg key val src
    if [ -n "${HOME:-}" ]; then
        p=$(realpath -m -- "$HOME" 2>/dev/null) && printf '%s|%s\n' "$p" "\$HOME"
    fi
    p=$(realpath -m -- /tmp 2>/dev/null) && printf '%s|%s\n' "$p" /tmp
    for cfg in "$CRT_CONF_DIR"/*; do
        [ -f "$cfg" ] || continue
        while read -r key val; do
            [ "$key" = mount ] && [ -n "$val" ] || continue
            src=${val%%:*}
            p=$(realpath -m -- "$src" 2>/dev/null) \
                && printf '%s|%s\n' "$p" "the mount source $src in the '${cfg##*/}' config"
        done < "$cfg"
    done
    return 0
}

check_crt_home_placement() {  # canonical CRT_HOME
    local home_real="$1" c
    local -a cand=()
    mapfile -t cand < <(crt_home_exposures)
    for c in "${cand[@]}"; do
        if _paths_overlap "$home_real" "${c%%|*}"; then
            echo "Error: CRT_HOME ($home_real) overlaps ${c#*|} (${c%%|*})," >&2
            echo "  which a non-hardened run can bind, so a container could change a" >&2
            echo "  rootfs, its config or its state. Move CRT_HOME outside \$HOME and /tmp" >&2
            echo "  (/data/crt/home/<user> or /home/crt is fine) and keep mount sources out" >&2
            echo "  of it. 'crt doctor' checks the placement." >&2
            return 1
        fi
    done
}

# A hardened run must not bind CRT_HOME, its config dir or its state dir, nor any
# directory that contains or sits inside them: rw would let the command rewrite
# a rootfs, config or marker, and ro would still expose configs. Paths are
# compared canonically (the state/config dirs are resolved on their own in case
# either is a symlink out of CRT_HOME).
check_binds_clear_of_crt() {  # home_real spec...
    local home_real="$1"; shift
    local -a guarded=("$home_real")
    local p spec src sp g
    for p in "$CRT_CONF_DIR" "$CRT_STATE_DIR"; do
        sp=$(realpath -m -- "$p" 2>/dev/null) && guarded+=("$sp")
    done
    for spec in "$@"; do
        src=${spec%%:*}
        sp=$(realpath -m -- "$src" 2>/dev/null) \
            || { echo "Error: cannot resolve mount source $src" >&2; return 1; }
        for g in "${guarded[@]}"; do
            if _paths_overlap "$sp" "$g"; then
                echo "Error: mount source $src ($sp) overlaps $g." >&2
                echo "  A hardened run may not bind CRT_HOME, its .config or .state," >&2
                echo "  or any directory containing them, read-write or read-only." >&2
                return 1
            fi
        done
    done
}

# This repo's own test/mocks dir, resolved from the script's real location. It
# is the only directory CRT_TEST_MODE may name; an installed crt has none.
crt_mocks_dir() {
    local self dir
    self=$(realpath -e -- "${BASH_SOURCE[0]}" 2>/dev/null) || return 1
    dir=$(realpath -e -- "$(dirname -- "$self")/test/mocks" 2>/dev/null) || return 1
    [ -f "$dir/.crt-mocks" ] || return 1
    printf '%s\n' "$dir"
}

# Test mode is on only when CRT_TEST_MODE names this repo's own test/mocks
# directory (resolved from the script's real location; it must carry the
# .crt-mocks marker). Any other value (a bare 1, a relative path, another
# directory with a marker, or an installed crt with no test dir) does nothing.
crt_test_mocks() {
    local mocks tm
    [ -n "${CRT_TEST_MODE:-}" ] || return 1
    mocks=$(crt_mocks_dir) || return 1
    tm=$(realpath -e -- "$CRT_TEST_MODE" 2>/dev/null) || return 1
    [ "$tm" = "$mocks" ] || return 1
    printf '%s\n' "$mocks"
}

# unshare comes from a fixed absolute list (never a PATH or function lookup),
# or from this repo's mocks under test mode.
find_unshare() {
    local p
    if [ -n "$CRT_TEST_MOCKS" ]; then
        printf '%s\n' "$CRT_TEST_MOCKS/unshare"; return 0
    fi
    for p in /usr/bin/unshare /bin/unshare /usr/sbin/unshare /sbin/unshare; do
        if [[ -x "$p" ]]; then printf '%s\n' "$p"; return 0; fi
    done
    return 1
}

parse_image_ref() {
    local input="$1"
    local registry repo tag

    # Extract tag: only if colon appears in the last path segment (after last slash)
    local last_seg="${input##*/}"
    if [[ "$last_seg" == *:* ]]; then
        tag="${last_seg##*:}"
        input="${input%:"${tag}"}"
    else
        tag="latest"
    fi

    # Extract registry: first component is a hostname if it contains '.' or ':'
    local first="${input%%/*}"
    if [[ "$input" == */* ]] && [[ "$first" == *.* || "$first" == *:* ]]; then
        registry="$first"
        repo="${input#*/}"
    elif [[ "$input" == */* ]]; then
        registry="registry-1.docker.io"
        repo="$input"
    else
        registry="registry-1.docker.io"
        repo="library/$input"
    fi

    echo "$registry" "$repo" "$tag"
}

oci_token() {
    local registry="$1"
    local repo="$2"
    local url token

    case "$registry" in
        registry-1.docker.io)
            url="https://auth.docker.io/token?service=registry.docker.io&scope=repository:${repo}:pull" ;;
        ghcr.io)
            url="https://ghcr.io/token?scope=repository:${repo}:pull" ;;
        quay.io)
            url="https://quay.io/v2/auth?service=quay.io&scope=repository:${repo}:pull" ;;
        *)
            url="https://${registry}/v2/auth?scope=repository:${repo}:pull" ;;
    esac

    token=$(curl -fsSL "$url" | jq -r '.token // .access_token') || {
        echo "Error: failed to fetch OCI token from $registry" >&2
        return 1
    }
    if [[ -z "$token" || "$token" == "null" ]]; then
        echo "Error: no token returned from $registry for $repo" >&2
        return 1
    fi
    echo "$token"
}

oci_manifest() {
    local registry="$1"
    local repo="$2"
    local tag="$3"
    local token="$4"
    local api_base="https://${registry}/v2/${repo}"
    local arch

    case "$(uname -m)" in
        x86_64)  arch="amd64" ;;
        aarch64) arch="arm64" ;;
        armv7l)  arch="arm" ;;
        *)       arch="$(uname -m)" ;;
    esac

    local manifest
    manifest=$(curl -fsSL \
        -H "Authorization: Bearer $token" \
        -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
        -H "Accept: application/vnd.oci.image.manifest.v1+json" \
        -H "Accept: application/vnd.docker.distribution.manifest.list.v2+json" \
        -H "Accept: application/vnd.oci.image.index.v1+json" \
        "${api_base}/manifests/${tag}") || {
        echo "Error: failed to fetch manifest for ${registry}/${repo}:${tag}" >&2
        return 1
    }

    # Detect image index: check mediaType field OR presence of .manifests array
    local is_index
    is_index=$(echo "$manifest" | jq -r '
        if (.mediaType // "" | test("index|list")) or (.manifests != null) then "yes" else "" end
    ')
    if [ "$is_index" = "yes" ]; then
        local digest
        digest=$(echo "$manifest" | jq -r \
            --arg arch "$arch" \
            '.manifests[] | select(.platform.architecture == $arch) | .digest' \
            | head -1)
        if [ -z "$digest" ]; then
            echo "Error: no manifest found for arch $arch in ${registry}/${repo}:${tag}" >&2
            return 1
        fi
        manifest=$(curl -fsSL \
            -H "Authorization: Bearer $token" \
            -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
            -H "Accept: application/vnd.oci.image.manifest.v1+json" \
            "${api_base}/manifests/${digest}") || {
            echo "Error: failed to fetch platform manifest ${digest}" >&2
            return 1
        }
    fi

    echo "$manifest"
}

# _blob_matches FILE sha256:HEX — true when FILE's sha256 equals the digest.
_blob_matches() {
    local sum
    sum=$(sha256sum -- "$1" 2>/dev/null) || return 1
    [ "sha256:${sum%% *}" = "$2" ]
}

oci_unpack() {
    local registry="$1"
    local repo="$2"
    local token="$3"
    local manifest="$4"
    local rootfs="$5"
    local api_base="https://${registry}/v2/${repo}"
    local rootfs_real
    rootfs_real=$(realpath -e -- "$rootfs") || return 1

    local layers
    layers=$(echo "$manifest" | jq -r '.layers[].digest')

    local cache_dir="$CRT_HOME/.cache/layers"
    mkdir -p "$cache_dir"

    local digest
    for digest in $layers; do
        case "$digest" in
            sha256:*) ;;
            *) echo "Error: unsupported layer digest '$digest' (sha256 only)" >&2; return 1 ;;
        esac
        if ! [[ "${digest#sha256:}" =~ ^[0-9a-f]{64}$ ]]; then
            echo "Error: malformed layer digest '$digest'" >&2; return 1
        fi
        local blob="$cache_dir/${digest//:/-}"
        echo "  layer ${digest:7:12}..."

        # A cached blob is reused only if it still matches its digest; a
        # corrupt or tampered cache entry is deleted and fetched again.
        if [ -f "$blob" ] && ! _blob_matches "$blob" "$digest"; then
            echo "  cached layer ${digest:7:12} fails its digest check, refetching" >&2
            rm -f "$blob"
        fi

        if [ ! -f "$blob" ]; then
            local blob_tmp="${blob}.tmp"
            curl -fsSL \
                -H "Authorization: Bearer $token" \
                "${api_base}/blobs/${digest}" \
                -o "$blob_tmp" || {
                rm -f "$blob_tmp"
                echo "Error: failed to download layer ${digest:7:12}" >&2
                return 1
            }
            if ! _blob_matches "$blob_tmp" "$digest"; then
                rm -f "$blob_tmp"
                echo "Error: layer ${digest:7:12} does not match its manifest digest" >&2
                return 1
            fi
            mv "$blob_tmp" "$blob"
        fi

        # Refuse a layer that could write, link or delete outside the rootfs
        # before touching anything. The digest only proves the registry sent
        # this layer, not that the layer is benign.
        _oci_check_layer "$rootfs_real" "$blob" || {
            echo "Error: layer ${digest:7:12} has a member that would escape the rootfs" >&2
            return 1
        }

        # Apply whiteouts from this layer's tar listing BEFORE extracting,
        # so we only delete lower-layer content, not the current layer's files.
        # The parent directory is resolved and must stay inside the rootfs; the
        # leaf itself is removed without following it.
        local wh_path wh_dir wh_name wh_parent
        while IFS= read -r wh_path; do
            wh_path="${wh_path#./}"
            wh_dir="$(dirname -- "$wh_path")"
            wh_name="$(basename -- "$wh_path")"
            case "$wh_name" in .wh.*) ;; *) continue ;; esac
            wh_parent=$(realpath -m -- "$rootfs_real/$wh_dir") || return 1
            case "$wh_parent" in
                "$rootfs_real"|"$rootfs_real"/*) ;;
                *) echo "Error: whiteout $wh_path escapes the rootfs" >&2; return 1 ;;
            esac
            if [ "$wh_name" = ".wh..wh..opq" ]; then
                if [ -d "$wh_parent" ] && [ ! -L "$wh_parent" ]; then
                    find "$wh_parent" -mindepth 1 -delete 2>/dev/null || true
                fi
            else
                rm -rf -- "${wh_parent:?}/${wh_name#.wh.}"
            fi
        done < <(LC_ALL=C.UTF-8 tar --quoting-style=escape -tzf "$blob" 2>/dev/null | grep '\.wh\.' || true)

        # Extract. GNU tar also refuses '..' members, strips a leading '/', and
        # defers symlinks whose target is absolute or contains '..' until the
        # end of the archive; the pre-check above does not rely on any of that.
        tar --no-same-owner -xzf "$blob" -C "$rootfs_real" 2>/dev/null || {
            echo "Error: failed to unpack layer ${digest:7:12}" >&2
            return 1
        }
        find "$rootfs_real" -name '.wh.*' -delete
    done
}

# _oci_check_layer ROOTFS BLOB — succeed only if extracting BLOB into ROOTFS
# cannot create, link or delete anything outside ROOTFS. Refuses member names
# and hardlink targets that are absolute, contain a '..' component, or need
# escaping in tar's listing, and any whose parent path runs through a symlink:
# one already in ROOTFS from a lower layer, or one this layer creates. Image
# layers record files at their real paths, so ordinary builds are unaffected.
#
# Names come from `tar -t` (one exact, escaped name per line), never from
# splitting the `tar -tv` text, where " -> " and " link to " inside a name are
# indistinguishable from the separators. The verbose listing, in the same
# order, supplies only the type; a hardlink target is what follows the exact
# name and " link to ". Listings run under a UTF-8 locale so ordinary
# non-ASCII names print literally; whatever tar still escapes (control
# characters, invalid UTF-8, a backslash, or everything non-ASCII when the
# locale is missing) is refused.
_oci_check_layer() {
    local rootfs="$1" blob="$2"
    local names_out verbose_out line kind rest name tail tgt i
    local -a raw=() vlines=() names=() kinds=() targets=()
    local -A lsym=() islink=()

    names_out=$(LC_ALL=C.UTF-8 tar --quoting-style=escape -tzf "$blob") || return 1
    verbose_out=$(LC_ALL=C.UTF-8 tar --numeric-owner --full-time \
                    --quoting-style=escape -tvzf "$blob") || return 1
    mapfile -t raw <<< "$names_out"
    mapfile -t vlines <<< "$verbose_out"
    if [ "${#raw[@]}" -ne "${#vlines[@]}" ]; then
        echo "  tar listings disagree on the member count" >&2; return 1
    fi

    # perms, uid/gid, size (or major,minor), date, time (PAX may add .fraction)
    local re='^(.)[^ ]* +[^ ]+ +[^ ]+ +[0-9-]+ +[0-9:.]+ (.*)$'
    for (( i = 0; i < ${#raw[@]}; i++ )); do
        name="${raw[i]}"; line="${vlines[i]}"
        if [ -z "$name" ] && [ -z "$line" ]; then continue; fi
        [[ "$line" =~ $re ]] || { echo "  unparsable tar entry: $line" >&2; return 1; }
        kind="${BASH_REMATCH[1]}"; rest="${BASH_REMATCH[2]}"; tgt=""
        if [ "${rest:0:${#name}}" != "$name" ]; then
            echo "  tar listings disagree on member $name" >&2; return 1
        fi
        tail="${rest:${#name}}"
        case "$kind" in
            l) [[ "$tail" == " -> "* ]] \
                   || { echo "  bad symlink entry: $line" >&2; return 1; } ;;
            h) [[ "$tail" == " link to "* ]] \
                   || { echo "  bad hardlink entry: $line" >&2; return 1; }
               tgt="${tail#" link to "}" ;;
            *) [ -z "$tail" ] || { echo "  unexpected tar entry: $line" >&2; return 1; } ;;
        esac
        name="${name#./}"; name="${name%/}"; tgt="${tgt#./}"
        names+=("$name"); kinds+=("$kind"); targets+=("$tgt")
        if [ "$kind" = l ]; then lsym["$name"]=1; fi
    done

    for (( i = 0; i < ${#names[@]}; i++ )); do
        if [ -z "${names[i]}" ] || [ "${names[i]}" = . ]; then continue; fi
        _layer_path_ok "${names[i]}" || return 1
        if [ "${kinds[i]}" = h ]; then _layer_path_ok "${targets[i]}" || return 1; fi
    done
    return 0
}

# _layer_path_ok P — used by _oci_check_layer (reads its rootfs, lsym and
# islink through bash dynamic scope). P must be relative, free of '..' and of
# tar escapes, and no proper prefix of it may be a symlink.
_layer_path_ok() {
    local p="$1" pre="" comp i n
    case "$p" in
        /*|*\\*) echo "  refused: $p" >&2; return 1 ;;
    esac
    local -a parts
    IFS=/ read -ra parts <<< "$p"
    n=${#parts[@]}
    for (( i = 0; i < n; i++ )); do
        comp="${parts[i]}"
        if [ "$comp" = .. ]; then echo "  refused '..' in: $p" >&2; return 1; fi
        if [ -z "$comp" ] || [ "$comp" = . ]; then continue; fi
        pre="${pre:+$pre/}$comp"
        (( i == n - 1 )) && break
        if [ -n "${lsym[$pre]:-}" ]; then
            echo "  refused path through symlink $pre: $p" >&2; return 1
        fi
        if [ -z "${islink[$pre]:-}" ]; then
            if [ -L "$rootfs/$pre" ]; then islink["$pre"]=1; else islink["$pre"]=0; fi
        fi
        if [ "${islink[$pre]}" = 1 ]; then
            echo "  refused path through symlink $pre: $p" >&2; return 1
        fi
    done
    return 0
}

parse_memory() {
    local val="$1"
    if [ -z "$val" ]; then
        echo "Error: parse_memory requires a value" >&2
        return 1
    fi
    local num="${val%[GgMmKk]}"
    if ! [[ "$num" =~ ^[0-9]+$ ]]; then
        echo "Error: invalid memory value '$val'" >&2
        return 1
    fi
    case "${val: -1}" in
        G|g) echo $(( num * 1024 * 1024 * 1024 )) ;;
        M|m) echo $(( num * 1024 * 1024 )) ;;
        K|k) echo $(( num * 1024 )) ;;
        *)   echo "$num" ;;
    esac
}

read_config() {
    local config_file="$1"
    config_image=""
    config_mounts=()
    config_envs=()
    config_memory=""
    config_cpus=""
    config_net=""
    config_home=""
    config_tmp=""
    config_envclean=""
    config_root=""
    config_packages=()
    config_keepfds=()

    [ -f "$config_file" ] || return 0

    local key val
    local -a _pkgs _fds
    while read -r key val; do
        case "$key" in
            '#'*|'') continue ;;
        esac
        if [ -z "$val" ]; then
            echo "Warning: config directive '$key' has no value, skipping" >&2
            continue
        fi
        case "$key" in
            image)     config_image="$val" ;;
            mount)     config_mounts+=("$val") ;;
            env)       config_envs+=("$val") ;;
            memory)    config_memory="$val" ;;
            cpus)      config_cpus="$val" ;;
            net)       config_net="$val" ;;
            home)      config_home="$val" ;;
            tmp)       config_tmp="$val" ;;
            env-clean) config_envclean="$val" ;;
            root)      config_root="$val" ;;
            packages)  read -ra _pkgs <<< "$val"; config_packages+=("${_pkgs[@]}") ;;
            keep-fd)   read -ra _fds <<< "$val"; config_keepfds+=("${_fds[@]}") ;;
        esac
    done < "$config_file"
}

write_config() {
    local config_file="$1"
    local image="$2"
    printf 'image %s\n' "$image" > "$config_file"
}

apply_cgroup() {
    local memory="$1"
    local cpus="$2"

    [ -z "$memory" ] && [ -z "$cpus" ] && return 0

    local cgroot="$CRT_SYSROOT/sys/fs/cgroup"
    if [ ! -f "$cgroot/cgroup.controllers" ]; then
        echo "Warning: cgroup v2 not available, resource limits not applied" >&2
        return 0
    fi

    # The run's cgroup is a direct child of user-<uid>, a sibling of the leaf
    # crt cgroup-exec starts callers in, so the move below has the user-owned
    # user-<uid> as its common ancestor, and user-<uid> itself holds no
    # processes (cgroup v2's no-internal-processes rule).
    local user_cg
    user_cg="$cgroot/user-$(id -u)"
    if [ ! -d "$user_cg" ]; then
        echo "Warning: cgroup not delegated for your user, resource limits not applied" >&2
        echo "  Run 'sudo crt setup' to enable memory/cpu limits." >&2
        return 0
    fi

    # Enable controllers in user's cgroup subtree (idempotent)
    echo "+memory +cpu" > "$user_cg/cgroup.subtree_control" 2>/dev/null || true

    local cg="$user_cg/crt-$$"
    if ! mkdir -p "$cg" 2>/dev/null; then
        echo "Warning: cannot create cgroup $cg, resource limits not applied" >&2
        return 0
    fi

    if ! echo $$ > "$cg/cgroup.procs" 2>/dev/null; then
        echo "Warning: cannot join cgroup, resource limits not applied" >&2
        echo "  Start the caller inside user-$(id -u): sudo crt cgroup-exec <user> -- ..." >&2
        rmdir "$cg" 2>/dev/null
        return 0
    fi

    # Record path for cleanup after unshare exits
    _CRT_CGROUP="$cg"

    if [ -n "$memory" ]; then
        local mem_bytes
        mem_bytes=$(parse_memory "$memory" 2>/dev/null) || {
            echo "Warning: invalid memory value '$memory', skipping" >&2
            mem_bytes=""
        }
        if [ -n "$mem_bytes" ]; then
            echo "$mem_bytes" > "$cg/memory.max" \
                || echo "Warning: failed to set memory limit to $memory" >&2
        fi
    fi

    if [ -n "$cpus" ]; then
        local quota
        quota=$(awk -v cpus="$cpus" 'BEGIN { printf "%d", cpus * 100000 }')
        echo "$quota 100000" > "$cg/cpu.max" \
            || echo "Warning: failed to set CPU limit to $cpus" >&2
    fi
}

_xbps_trust_keys() {
    # xbps-install into an empty rootfs has no repo signing keys, so it stops to
    # import them — which fails non-interactively ("failed to import public
    # key"). Trust the host's keys by copying them in before the install.
    local rootfs="$1"
    local src="${XBPS_KEYS_DIR:-/var/db/xbps/keys}"

    local count=0 f
    for f in "$src"/*.plist; do [ -e "$f" ] && count=$((count + 1)); done
    if [ "$count" -eq 0 ]; then
        echo "Error: no xbps repo keys found in $src on this host." >&2
        echo "  Install the 'xbps' package (it ships the Void repo keys) or bootstrap" >&2
        echo "  from an OCI image instead (e.g. crt create $rootfs alpine:3.19)." >&2
        return 1
    fi
    mkdir -p "$rootfs/var/db/xbps/keys"
    cp -- "$src"/*.plist "$rootfs/var/db/xbps/keys/"
}

_create_xbps() {
    local rootfs="$1"
    local repo="${VOID_REPO:-https://repo-default.voidlinux.org/current}"

    if ! command -v xbps-install >/dev/null 2>&1; then
        echo "Error: xbps-install not found. Install xbps or pass an OCI image name." >&2
        return 1
    fi

    _xbps_trust_keys "$rootfs" || return 1
    echo "Bootstrapping Void Linux via xbps..."
    # -S syncs the remote repository index first (without it, base-minimal is
    # "not found" because the local index is empty). stdin is /dev/null so a
    # repo signed by a key the host does not trust fails instead of prompting.
    xbps-install -S -r "$rootfs" --repository="$repo" -y base-minimal </dev/null
}

_install_packages() {
    local rootfs="$1"; shift
    [ $# -eq 0 ] && return 0
    local repo="${VOID_REPO:-https://repo-default.voidlinux.org/current}"

    if ! command -v xbps-install >/dev/null 2>&1; then
        echo "Error: xbps-install not found; cannot install packages: $*" >&2
        return 1
    fi

    echo "Installing packages: $*"
    xbps-install -S -r "$rootfs" --repository="$repo" -y "$@" </dev/null
}

_create_oci() {
    local image="$1"
    local rootfs="$2"

    for dep in curl jq tar; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            echo "Error: '$dep' is required for OCI image pull" >&2
            return 1
        fi
    done

    echo "Pulling OCI image '$image'..."

    local registry repo tag
    read -r registry repo tag <<< "$(parse_image_ref "$image")"

    local token manifest
    token=$(oci_token "$registry" "$repo")
    manifest=$(oci_manifest "$registry" "$repo" "$tag" "$token")
    oci_unpack "$registry" "$repo" "$token" "$manifest" "$rootfs"
}

cmd_create() {
    local name="$1"
    local arg="${2:-}"

    if [ -z "$name" ]; then
        echo "Usage: crt create <name> [image|config-file]"
        echo "  no second arg:   bootstrap Void Linux via xbps"
        echo "  image reference: pull from OCI registry (e.g. ubuntu:22.04)"
        echo "  config file:     read directives from file (image, packages, mount, env, memory, cpus, net, home, tmp, env-clean, root)"
        exit 1
    fi

    validate_name "$name"
    local rootfs="$CRT_HOME/$name"

    if [ -e "$rootfs" ] || [ -L "$rootfs" ]; then
        echo "Chroot '$name' already exists at $rootfs"
        exit 1
    fi

    local stored_config="$CRT_CONF_DIR/$name"
    local marker
    marker=$(pristine_marker "$name")
    mkdir -p "$rootfs" "$CRT_CONF_DIR" "$CRT_STATE_DIR"
    # Clean up a partial create however it stops. An EXIT trap is used because
    # an ERR trap does not fire when set -e aborts inside a called function.
    # Paths are expanded now so the trap does not depend on function locals.
    # shellcheck disable=SC2064
    trap "rm -rf -- $(printf '%q ' "$rootfs" "$stored_config" "$marker")" EXIT
    # No marker until the rootfs is fully built (a stale one is never trusted:
    # it records the identity of a different directory).
    rm -f -- "$marker"

    if [ -z "$arg" ]; then
        _create_xbps "$rootfs"
        write_config "$stored_config" "void"
    elif [ -f "$arg" ]; then
        local config_image="" config_memory="" config_cpus=""
        local config_net="" config_home="" config_tmp="" config_envclean="" config_root=""
        local -a config_mounts=() config_envs=() config_packages=() config_keepfds=()
        read_config "$arg"
        if [ -z "$config_image" ] || [ "$config_image" = "void" ]; then
            _create_xbps "$rootfs"
            _install_packages "$rootfs" "${config_packages[@]}"
        else
            _create_oci "$config_image" "$rootfs"
            [ ${#config_packages[@]} -gt 0 ] && \
                echo "Warning: 'packages' directive ignored for OCI image '$config_image'" >&2
        fi
        cp "$arg" "$stored_config"
    else
        _create_oci "$arg" "$rootfs"
        write_config "$stored_config" "$arg"
    fi

    mark_pristine "$name" "$rootfs" \
        || { echo "Error: could not write the pristine marker for '$name'" >&2; exit 1; }
    trap - EXIT
    echo "Created: $rootfs ($(du -sh "$rootfs" 2>/dev/null | cut -f1))"
}

cmd_enter() {
    if [ -z "${1:-}" ]; then
        echo "Usage: crt enter <name>"
        exit 1
    fi
    cmd_run "$1" /bin/bash -l
}

cmd_run() {
    local -a flag_mounts=() flag_envs=() flag_keepfds=()
    local flag_memory="" flag_cpus=""
    local flag_net="" flag_home="" flag_tmp="" flag_cleanenv="" flag_roroot=""

    # Manual parser: original short flags (-v -e -m -c) plus long flags.
    # Value-taking short flags accept an attached (-vX) or separate (-v X) form.
    local val
    while [ $# -gt 0 ]; do
        case "$1" in
            -v|--volume) val="$2"; [ $# -ge 2 ] || { echo "Error: $1 requires an argument" >&2; exit 1; }
                         flag_mounts+=("$val"); shift 2 ;;
            -e|--env)    val="$2"; [ $# -ge 2 ] || { echo "Error: $1 requires an argument" >&2; exit 1; }
                         flag_envs+=("$val"); shift 2 ;;
            -m|--memory) val="$2"; [ $# -ge 2 ] || { echo "Error: $1 requires an argument" >&2; exit 1; }
                         flag_memory="$val"; shift 2 ;;
            -c|--cpus)   val="$2"; [ $# -ge 2 ] || { echo "Error: $1 requires an argument" >&2; exit 1; }
                         flag_cpus="$val"; shift 2 ;;
            -v*) flag_mounts+=("${1#-v}"); shift ;;
            -e*) flag_envs+=("${1#-e}"); shift ;;
            -m*) flag_memory="${1#-m}"; shift ;;
            -c*) flag_cpus="${1#-c}"; shift ;;
            --net)  [ $# -ge 2 ] || { echo "Error: --net requires an argument" >&2; exit 1; }
                    flag_net="$2"; shift 2 ;;
            --tmp)  [ $# -ge 2 ] || { echo "Error: --tmp requires an argument" >&2; exit 1; }
                    flag_tmp="$2"; shift 2 ;;
            --keep-fd)  [ $# -ge 2 ] || { echo "Error: --keep-fd requires an argument" >&2; exit 1; }
                    flag_keepfds+=("$2"); shift 2 ;;
            --no-home)   flag_home="no"; shift ;;
            --clean-env) flag_cleanenv="yes"; shift ;;
            --ro-root)   flag_roroot="ro"; shift ;;
            --) shift; break ;;
            -*) echo "Error: unknown option $1" >&2; exit 1 ;;
            *)  break ;;
        esac
    done

    local name="$1"

    if [ -z "$name" ]; then
        echo "Usage: crt run [-v h:c[:ro]] [-e NAME[=val]] [-m SIZE] [-c FLOAT]" >&2
        echo "               [--net none|host] [--no-home] [--tmp private|host]" >&2
        echo "               [--clean-env] [--ro-root] <name> [cmd...]" >&2
        exit 1
    fi
    shift
    validate_name "$name"

    local rootfs="$CRT_HOME/$name"

    if [ ! -d "$rootfs/bin" ]; then
        echo "Error: Chroot '$name' not found" >&2
        echo "Run: crt create $name" >&2
        exit 1
    fi

    # Canonicalise CRT_HOME and the rootfs once (a symlinked CRT_HOME component
    # must not make every later "path escapes rootfs" check fail), and require
    # the rootfs to be the real directory CRT_HOME/<name>, not a symlink alias.
    local home_real rootfs_real
    home_real=$(realpath -e -- "$CRT_HOME") \
        || { echo "Error: cannot resolve CRT_HOME $CRT_HOME" >&2; exit 1; }
    rootfs_real=$(realpath -e -- "$rootfs") \
        || { echo "Error: cannot resolve rootfs path $rootfs" >&2; exit 1; }
    if [ "$rootfs_real" != "$home_real/$name" ]; then
        echo "Error: '$rootfs' resolves to $rootfs_real, not $home_real/$name;" >&2
        echo "  a rootfs must be a real directory directly under CRT_HOME." >&2
        exit 1
    fi
    rootfs="$rootfs_real"

    # Stored config lives outside every rootfs so a container cannot read or
    # rewrite the config that governs its own (or a later) run. Migrate a legacy
    # in-rootfs config once, by moving it out (never copying, never reading it
    # from inside the rootfs afterwards). Only a regular, non-symlink file is
    # migrated, and a migrated rootfs is not pristine: its history is unknown.
    local stored_config="$CRT_CONF_DIR/$name"
    if [ ! -e "$stored_config" ] && { [ -e "$rootfs/config" ] || [ -L "$rootfs/config" ]; }; then
        if [ -L "$rootfs/config" ] || [ ! -f "$rootfs/config" ]; then
            echo "Error: legacy $rootfs/config is not a regular file; refusing to migrate it." >&2
            echo "  Remove it and write $stored_config yourself." >&2
            exit 1
        fi
        mkdir -p "$CRT_CONF_DIR"
        mv -- "$rootfs/config" "$stored_config"
        if [ -L "$stored_config" ] || [ ! -f "$stored_config" ]; then
            rm -f -- "$stored_config"
            echo "Error: migrated config for '$name' is not a regular file; removed it." >&2
            exit 1
        fi
        clear_pristine "$name" \
            || { echo "Error: cannot clear the pristine marker for '$name'" >&2; exit 1; }
    fi

    # Load stored config
    local config_image="" config_memory="" config_cpus=""
    local config_net="" config_home="" config_tmp="" config_envclean="" config_root=""
    local -a config_mounts=() config_envs=() config_packages=() config_keepfds=()
    read_config "$stored_config"

    # Merge: config first, flags override/extend
    local -a all_mounts=("${config_mounts[@]}" "${flag_mounts[@]}")
    local -a all_envs=("${config_envs[@]}" "${flag_envs[@]}")
    local -a all_keepfds=("${config_keepfds[@]}" "${flag_keepfds[@]}")
    local memory="${flag_memory:-$config_memory}"
    local cpus="${flag_cpus:-$config_cpus}"
    local net_mode="${flag_net:-${config_net:-host}}"
    local home_mode="${flag_home:-${config_home:-yes}}"
    local tmp_mode="${flag_tmp:-${config_tmp:-host}}"
    local clean_mode="${flag_cleanenv:-${config_envclean:-no}}"
    local root_mode="${flag_roroot:-${config_root:-rw}}"

    # Validate mount specs
    local spec
    for spec in "${all_mounts[@]}"; do
        if [[ "$spec" != *:* ]]; then
            echo "Error: mount '$spec' must be host:container[:ro]" >&2
            exit 1
        fi
    done

    # Normalise modes to booleans passed into the namespace
    local no_home=0 private_tmp=0 net_none=0 ro_root=0 clean_env=0
    case "$home_mode" in no|none|false|0) no_home=1 ;; yes|true|1|"") : ;;
        *) echo "Error: invalid home mode '$home_mode' (use yes|no)" >&2; exit 1 ;; esac
    case "$tmp_mode" in private|priv) private_tmp=1 ;; host|shared|"") : ;;
        *) echo "Error: invalid tmp mode '$tmp_mode' (use private|host)" >&2; exit 1 ;; esac
    case "$net_mode" in none|off|no) net_none=1 ;; host|""|share) : ;;
        *) echo "Error: invalid net mode '$net_mode' (use none|host)" >&2; exit 1 ;; esac
    case "$root_mode" in ro|readonly) ro_root=1 ;; rw|""|readwrite) : ;;
        *) echo "Error: invalid root mode '$root_mode' (use ro|rw)" >&2; exit 1 ;; esac
    case "$clean_mode" in yes|true|1|clean) clean_env=1 ;; no|false|0|"") : ;;
        *) echo "Error: invalid env-clean mode '$clean_mode' (use yes|no)" >&2; exit 1 ;; esac

    # Hardened when any isolation is requested: setup fails closed and the
    # command runs with all capabilities dropped (see the inner script).
    local hardened=0
    if [ "$no_home" = 1 ] || [ "$private_tmp" = 1 ] || [ "$net_none" = 1 ] \
       || [ "$ro_root" = 1 ] || [ "$clean_env" = 1 ]; then
        hardened=1
    fi
    for spec in "${all_mounts[@]}"; do
        case "$spec" in *:*:ro) hardened=1 ;; esac
    done

    # Trusted binary path. crt resolves the host-side helpers it runs (unshare,
    # and inside the namespace mount/pivot_root/setpriv/...) from this fixed path,
    # never the caller's PATH, so an -e/config PATH cannot substitute them.
    local crt_binpath="$CRT_TRUSTED_PATH"

    # Test mode (see crt_test_mocks) routes binary resolution through the
    # mocks, allows the chroot fallback, and skips the findmnt ro verification.
    local crt_test=0
    if [ -n "$CRT_TEST_MOCKS" ]; then
        crt_test=1
        crt_binpath="$CRT_TEST_MOCKS:$CRT_TRUSTED_PATH"
    fi

    # Hardened mode runs rootfs binaries (umount, setpriv) after pivot_root while
    # still privileged, so it is only trusted on a rootfs that is exactly what
    # crt create wrote: it requires the pristine marker for this rootfs identity,
    # forces the rootfs read-only, and requires CRT_HOME to be out of reach of
    # every non-hardened run. Any non-hardened run deletes the marker first, and
    # does not start if it cannot.
    if [ "$hardened" = 1 ]; then
        ro_root=1
        if ! is_pristine "$name" "$rootfs"; then
            echo "Error: '$name' is not pristine: it was run writable, migrated, renamed," >&2
            echo "  or not made by crt create. Hardened isolation trusts the rootfs's own" >&2
            echo "  umount/setpriv, so it needs a fresh rootfs that is only run hardened:" >&2
            echo "    crt rm $name && crt create $name ..." >&2
            exit 1
        fi
        check_crt_home_placement "$home_real" || exit 1
        check_binds_clear_of_crt "$home_real" "${all_mounts[@]}" || exit 1
    else
        clear_pristine "$name" \
            || { echo "Error: cannot remove the pristine marker for '$name'; not starting." >&2; exit 1; }
    fi

    local UNSHARE=""
    UNSHARE=$(find_unshare) || UNSHARE=""
    [[ -n "$UNSHARE" && -x "$UNSHARE" ]] \
        || { echo "Error: unshare not found in /usr/bin, /bin, /usr/sbin or /sbin" >&2; exit 1; }

    # Resolve env entries in the parent, where the caller's environment is visible.
    #   NAME=value  -> passed through as-is
    #   NAME        -> substituted with the caller's current value (skipped if unset)
    # These are never exported into the crt process itself; they are passed to the
    # namespace and applied to the command only (via env / env -i in the payload),
    # so an -e value cannot influence crt's own binary lookup or behavior.
    # A passed-through NODE_CHANNEL_FD is auto-kept only if it names an open fd > 2.
    local -a resolved_envs=()
    local env_spec ename value
    for env_spec in "${all_envs[@]}"; do
        if [[ "$env_spec" == *=* ]]; then
            resolved_envs+=("$env_spec"); ename=${env_spec%%=*}; value=${env_spec#*=}
        elif [ -n "${!env_spec+x}" ]; then
            ename=$env_spec; value=${!env_spec}; resolved_envs+=("$ename=$value")
        else
            echo "Warning: -e $env_spec: not set in environment, skipping" >&2
            continue
        fi
        if [ "$ename" = NODE_CHANNEL_FD ] && [[ "$value" =~ ^[0-9]+$ ]] \
           && [ "$value" -gt 2 ] && [ -e "/proc/self/fd/$value" ]; then
            all_keepfds+=("$value")
        fi
    done

    # Validate the keep-fd list (numeric fds only).
    local fd
    for fd in "${all_keepfds[@]}"; do
        if ! [[ "$fd" =~ ^[0-9]+$ ]]; then
            echo "Error: --keep-fd '$fd' must be a number" >&2; exit 1
        fi
    done
    local keepfds="${all_keepfds[*]}"

    # Minimal environment used only when --clean-env is in effect.
    local minpath="/usr/bin:/bin:/usr/local/bin"
    local minhome="/tmp"

    # Apply cgroup limits before exec
    _CRT_CGROUP=""
    apply_cgroup "$memory" "$cpus"

    [ $# -eq 0 ] && set -- /bin/bash -l

    local workdir
    workdir="$(pwd)"

    local -a unshare_args=(--user --map-root-user --mount --pid --uts --ipc)
    [ "$net_none" = 1 ] && unshare_args+=(--net)
    unshare_args+=(-f)

    # shellcheck disable=SC2016
    "$UNSHARE" "${unshare_args[@]}" \
        /bin/bash -c '
            set +e
            rootfs=$1; userhome=$2; workdir=$3
            no_home=$4; private_tmp=$5; net_none=$6; ro_root=$7; clean_env=$8
            hardened=$9; shift 9
            crt_test=$1; binpath=$2; minpath=$3; minhome=$4; keepfds=$5; nmounts=$6; shift 6

            # Fixed, trusted PATH for every helper crt runs in here (mount, pivot_root,
            # umount, findmnt, realpath, setpriv, ...), so an -e/config PATH cannot
            # substitute them. In test mode this leads with the mocks dir.
            export PATH="$binpath"

            crt_die() { echo "crt: $1" >&2; exit 1; }
            # req: always required. hreq: required only in hardened mode.
            req()  { "$@" && return 0; crt_die "step failed: $*"; }
            hreq() { "$@" && return 0; [ "$hardened" = 1 ] && crt_die "step failed: $*"; return 0; }
            # canon: canonical path that must stay under the rootfs (no symlink escape).
            canon() {
                local t; t=$(realpath -m -- "$1") || crt_die "cannot resolve $1"
                case "$t" in "$rootfs"|"$rootfs"/*) printf "%s\n" "$t" ;;
                    *) crt_die "path escapes rootfs: $1 -> $t" ;; esac
            }
            # safe_dir: canonical dir under the rootfs, created; refuses a symlink escape.
            # canon runs in a command substitution, so it exits only this subshell;
            # the caller must guard the assignment (x=$(safe_dir …) || crt_die).
            safe_dir() { local d; d=$(canon "$1") || exit 1; mkdir -p "$d" || exit 1; printf "%s\n" "$d"; }
            # safe_file: a regular file to use as a bind target. The parent dir must be
            # under the rootfs; a symlink planted at the leaf is removed, never followed.
            safe_file() {
                local p d b
                d=$(canon "$(dirname -- "$1")") || exit 1
                mkdir -p "$d" || exit 1
                b=$(basename -- "$1"); p="$d/$b"
                [ -L "$p" ] && rm -f "$p"
                [ -e "$p" ] || : > "$p" || exit 1
                printf "%s\n" "$p"
            }
            # verify_ro: every mount at/under $1 must be read-only (fail closed).
            verify_ro() {
                local out t opts
                out=$(findmnt -nrR -o TARGET,VFS-OPTIONS -- "$1" 2>/dev/null)
                [ -n "$out" ] || crt_die "read-only bind not found: $1"
                while read -r t opts; do
                    case ",$opts," in *,ro,*) ;; *) crt_die "not read-only: $t ($opts)" ;; esac
                done <<RO
$out
RO
            }

            # All fixed setup paths go through canon/safe_* so a symlink planted inside
            # the rootfs cannot redirect a mkdir/touch/mount to a host path.
            rproc=$(safe_dir "$rootfs/proc")     || crt_die "setup /proc"
            retc=$(safe_dir "$rootfs/etc")       || crt_die "setup /etc"
            safe_dir "$rootfs/oldroot" >/dev/null || crt_die "setup /oldroot"
            rdev=$(safe_dir "$rootfs/dev")       || crt_die "setup /dev"
            rpts=$(safe_dir "$rootfs/dev/pts")   || crt_die "setup /dev/pts"
            rshm=$(safe_dir "$rootfs/dev/shm")   || crt_die "setup /dev/shm"
            rtmp=$(safe_dir "$rootfs/tmp")       || crt_die "setup /tmp"
            rsys=$(safe_dir "$rootfs/sys")       || crt_die "setup /sys"

            hreq mount --make-rprivate /
            # Make the rootfs a mount point first, so every submount below lands
            # on top of it and pivot_root can later use it as the new root.
            hreq mount --bind "$rootfs" "$rootfs"
            hreq mount -t proc proc "$rproc"
            if [ "$net_none" = 1 ]; then
                mount -t sysfs sysfs "$rsys" 2>/dev/null || true
            else
                mount --bind /sys "$rsys" 2>/dev/null \
                    || mount -t sysfs sysfs "$rsys" 2>/dev/null || true
            fi

            # Minimal /dev: bind only safe device nodes (never all of host /dev,
            # which would expose block/input/kvm devices), plus a fresh devpts and
            # a private tmpfs /dev/shm. Device nodes are bound onto the rootfs disk
            # (the kernel forbids device writes on a userns-created tmpfs).
            for n in null zero full random urandom tty; do
                [ -e "/dev/$n" ] || continue
                dn=$(safe_file "$rdev/$n") || crt_die "setup /dev/$n"
                hreq mount --bind "/dev/$n" "$dn"
            done
            hreq mount -t devpts devpts "$rpts" -o newinstance,ptmxmode=0666,mode=0620
            ln -sfn pts/ptmx "$rdev/ptmx" 2>/dev/null || true
            hreq mount -t tmpfs tmpfs "$rshm"

            rc=$(safe_file "$retc/resolv.conf") || crt_die "setup /etc/resolv.conf"
            mount --bind /etc/resolv.conf "$rc" 2>/dev/null || true

            if [ "$private_tmp" = 1 ]; then
                hreq mount -t tmpfs tmpfs "$rtmp"
            else
                hreq mount --bind /tmp "$rtmp"
            fi

            if [ "$no_home" != 1 ]; then
                htgt=$(canon "$rootfs$userhome") || crt_die "resolve home target"
                mkdir -p "$htgt" || crt_die "mkdir home target"
                hreq mount --bind "$userhome" "$htgt"
            fi

            i=0
            while [ "$i" -lt "$nmounts" ]; do
                spec=$1; shift; i=$((i+1))
                mode=rw
                case "$spec" in
                    *:*:ro) mode=ro; spec=${spec%:ro} ;;
                    *:*:rw) spec=${spec%:rw} ;;
                esac
                host=${spec%%:*}; container=${spec#*:}
                tgt=$(canon "$rootfs$container") || crt_die "resolve mount target $container"
                mkdir -p "$tgt" || crt_die "mkdir mount target $container"
                req mount --rbind "$host" "$tgt"
                if [ "$mode" = ro ]; then
                    mount -o remount,bind,ro=recursive "$tgt" 2>/dev/null \
                        || req mount -o remount,bind,ro "$tgt"
                    [ "$crt_test" = 1 ] || verify_ro "$tgt"
                fi
            done

            [ "$net_none" = 1 ] && hreq ip link set lo up
            [ "$ro_root" = 1 ] && hreq mount -o remount,bind,ro "$rootfs"

            # Close every fd above stderr except the explicit keep list, so a fd the
            # caller leaked without O_CLOEXEC cannot be a handle outside the root.
            for fdp in /proc/self/fd/*; do
                n=${fdp##*/}
                [ "$n" -gt 2 ] 2>/dev/null || continue
                case " $keepfds " in *" $n "*) continue ;; esac
                eval "exec $n>&-" 2>/dev/null
            done

            # POSIX-sh payload (runs under the rootfs /bin/sh, which may be dash):
            # cd into the work dir, then apply the requested environment to the command.
            # env(1) stops treating args as assignments at the first non-NAME=val word,
            # so the resolved NAME=val entries precede the command with no count needed.
            # env is resolved absolutely so a poisoned rootfs cannot substitute it.
            payload='"'"'
                wd=$1; clean=$2; mp=$3; mh=$4; shift 4
                cd "$wd" 2>/dev/null || cd /
                E=env; [ -x /usr/bin/env ] && E=/usr/bin/env || { [ -x /bin/env ] && E=/bin/env; }
                if [ "$clean" = 1 ]; then
                    exec "$E" -i "PATH=$mp" "HOME=$mh" "$@"
                else
                    exec "$E" "$@"
                fi
            '"'"'

            cd "$rootfs" 2>/dev/null || crt_die "cannot cd into rootfs"
            if pivot_root . oldroot 2>/dev/null; then
                # The old root must be gone before the command runs. No redirect to a
                # path inside the new root (it may not exist / be read-only), then verify.
                umount -l /oldroot || crt_die "could not detach old root"
                # Verify the old root is gone, using only bash builtins (no rootfs
                # binary), then fail closed if any /oldroot mount remains.
                _old=0
                while read -r _f1 _f2 _f3 _f4 _mp _rest; do
                    case "$_mp" in /oldroot|/oldroot/*) _old=$((_old + 1)) ;; esac
                done < /proc/self/mountinfo
                [ "$_old" -eq 0 ] || crt_die "old root still mounted after pivot"
                rmdir /oldroot 2>/dev/null || true
                if [ "$hardened" = 1 ]; then
                    # Drop all privileges via an absolute setpriv (never a PATH lookup,
                    # so a binary planted earlier on PATH cannot run with capabilities).
                    setpriv=""
                    for p in /usr/bin/setpriv /bin/setpriv /usr/sbin/setpriv /sbin/setpriv; do
                        [ -x "$p" ] && { setpriv=$p; break; }
                    done
                    [ -n "$setpriv" ] || crt_die "setpriv not found in rootfs (needed to drop privileges)"
                    exec "$setpriv" --no-new-privs --bounding-set=-all \
                            --inh-caps=-all --ambient-caps=-all \
                        /bin/sh -c "$payload" crt \
                            "$workdir" "$clean_env" "$minpath" "$minhome" "$@"
                else
                    exec /bin/sh -c "$payload" crt \
                        "$workdir" "$clean_env" "$minpath" "$minhome" "$@"
                fi
            elif [ "$crt_test" = 1 ]; then
                # Test-only path (PATH mocks, no real mount namespace): the mock
                # pivot_root always fails, so fall back to chroot to exercise the code.
                exec chroot "$rootfs" /bin/sh -c "$payload" crt \
                    "$workdir" "$clean_env" "$minpath" "$minhome" "$@"
            else
                crt_die "pivot_root failed; refusing to run without isolation"
            fi
        ' -- "$rootfs" "$HOME" "$workdir" \
            "$no_home" "$private_tmp" "$net_none" "$ro_root" "$clean_env" "$hardened" \
            "$crt_test" "$crt_binpath" "$minpath" "$minhome" "$keepfds" \
            "${#all_mounts[@]}" "${all_mounts[@]}" \
            "${resolved_envs[@]}" "$@"
    local _rc
    _rc=$?
    [ -n "${_CRT_CGROUP:-}" ] && rmdir "$_CRT_CGROUP" 2>/dev/null || true
    exit "$_rc"
}

cmd_list() {
    if [ ! -d "$CRT_HOME" ]; then
        echo "No chroots found in $CRT_HOME"
        exit 0
    fi

    echo "NAME            SIZE      PATH"
    for dir in "$CRT_HOME"/*/; do
        [ -d "$dir" ] || continue
        local name size
        name=$(basename "$dir")
        size=$(du -sh "$dir" 2>/dev/null | cut -f1)
        printf "%-15s %-9s %s\n" "$name" "$size" "$dir"
    done
}

cmd_rm() {
    local name="$1"

    if [ -z "$name" ]; then
        echo "Usage: crt rm <name>"
        exit 1
    fi
    validate_name "$name"

    local rootfs="$CRT_HOME/$name"

    if [ ! -d "$rootfs" ] || [ -L "$rootfs" ]; then
        echo "Error: Chroot '$name' not found"
        exit 1
    fi

    echo "Removing $rootfs..."
    rm -rf -- "$rootfs"
    # Remove the out-of-rootfs stored config and state too (.tainted is the
    # pre-pristine-marker state file, removed if a legacy one is left).
    rm -f -- "$CRT_CONF_DIR/$name" "$(pristine_marker "$name")" "$CRT_STATE_DIR/$name.tainted"
    echo "Removed chroot '$name'"
}

cmd_export() {
    local name="$1"
    local binary="$2"
    local wrapper_name="${3:-$(basename "$binary")}"

    if [ -z "$name" ] || [ -z "$binary" ]; then
        echo "Usage: crt export <name> <binary> [wrapper-name]"
        echo ""
        echo "Examples:"
        echo "  crt export ubuntu perl"
        echo "  crt export ubuntu /usr/bin/python3 python"
        exit 1
    fi
    validate_name "$name"

    local rootfs="$CRT_HOME/$name"

    if [ ! -d "$rootfs/bin" ]; then
        echo "Error: Chroot '$name' not found"
        exit 1
    fi

    # Find the binary in the chroot
    local bin_path=""
    if [[ "$binary" == /* ]]; then
        bin_path="$binary"
    else
        # Search common paths
        for p in /usr/bin /bin /usr/local/bin /usr/sbin /sbin; do
            if [ -f "$rootfs$p/$binary" ]; then
                bin_path="$p/$binary"
                break
            fi
        done
    fi

    if [ -z "$bin_path" ] || [ ! -f "$rootfs$bin_path" ]; then
        echo "Error: Binary '$binary' not found in chroot '$name'"
        exit 1
    fi

    mkdir -p "$CRT_BIN"

    local wrapper="$CRT_BIN/$wrapper_name"
    local self_path
    self_path="$(realpath "$0")"

    cat > "$wrapper" << EOF
#!/bin/bash
# crt wrapper for $bin_path from $name
exec "$self_path" run "$name" "$bin_path" "\$@"
EOF

    chmod +x "$wrapper"
    echo "Exported: $wrapper -> $name:$bin_path"
}

# ── Install layout: install, setup, doctor ────────────────────────────────────
# <prefix> (default /data/crt, root, 755) holds bin/crt (root, 755) and
# home/<user>, each user's CRT_HOME (owned by the user, 700). Under test mode
# CRT_TEST_SYSROOT prefixes the system paths and CRT_TEST_EUID fakes the uid.

crt_euid() {
    if [ -n "$CRT_TEST_MOCKS" ] && [ -n "${CRT_TEST_EUID:-}" ]; then
        printf '%s\n' "$CRT_TEST_EUID"
    else
        id -u
    fi
}

require_root() {  # subcommand
    if [ "$(crt_euid)" != 0 ]; then
        echo "Error: 'crt $1' must run as root." >&2
        echo "  Try: sudo crt $1" >&2
        exit 1
    fi
}

# Root-only commands resolve their helpers from the trusted PATH, as cmd_run does.
use_trusted_path() {
    PATH=$CRT_TRUSTED_PATH
    if [ -n "$CRT_TEST_MOCKS" ]; then PATH="$CRT_TEST_MOCKS:$PATH"; fi
    export PATH
}

# Under test mode the invoking user stands in for root as an owner.
_is_root_uid() {
    [ "$1" = 0 ] || { [ -n "$CRT_TEST_MOCKS" ] && [ "$1" = "$(id -u)" ]; }
}

# check_root_only_path P — P and every existing directory above it is owned by
# root and not writable by group or other (sticky directories excepted), so no
# other user can rename or replace what crt installs below it.
check_root_only_path() {
    local d owner mode
    d=$(realpath -m -- "$1") || return 1
    while :; do
        if [ -e "$d" ]; then
            read -r owner mode < <(stat -c '%u %a' -- "$d") || return 1
            if ! _is_root_uid "$owner"; then
                echo "Error: $d is owned by uid $owner, not root." >&2; return 1
            fi
            if (( (8#$mode & 8#022) && !(8#$mode & 8#1000) )); then
                echo "Error: $d is writable by group or other (mode $mode)." >&2; return 1
            fi
        fi
        [ "$d" = / ] && return 0
        d=$(dirname -- "$d")
    done
}

make_root_dir() {  # dir: create it, or fix it, as root-owned 755
    if [ -L "$1" ] || { [ -e "$1" ] && [ ! -d "$1" ]; }; then
        echo "Error: $1 exists and is not a directory." >&2; return 1
    fi
    mkdir -p -- "$1" && chown -- root:root "$1" && chmod 755 -- "$1"
}

parse_prefix() {  # value — prints the canonical absolute prefix
    case "$1" in
        /?*) realpath -m -- "$1" ;;
        *) echo "Error: the prefix must be an absolute path other than /" >&2; return 1 ;;
    esac
}

_same_content() {
    local a b
    a=$(sha256sum -- "$1" 2>/dev/null) && b=$(sha256sum -- "$2" 2>/dev/null) \
        && [ "${a%% *}" = "${b%% *}" ]
}

cmd_install() {
    local prefix="$CRT_DATA_PREFIX"
    while [ $# -gt 0 ]; do
        case "$1" in
            --prefix)   [ $# -ge 2 ] || { echo "Error: --prefix requires a directory" >&2; exit 1; }
                        prefix="$2"; shift 2 ;;
            --prefix=*) prefix="${1#--prefix=}"; shift ;;
            *) echo "Usage: crt install [--prefix DIR]" >&2; exit 1 ;;
        esac
    done
    prefix=$(parse_prefix "$prefix") || exit 1
    require_root install
    use_trusted_path

    local self dest tmp link
    self=$(realpath -e -- "${BASH_SOURCE[0]}") \
        || { echo "Error: cannot resolve the running crt script" >&2; exit 1; }
    check_root_only_path "$(dirname -- "$prefix")" || exit 1
    make_root_dir "$prefix" && make_root_dir "$prefix/bin" && make_root_dir "$prefix/home" \
        || exit 1

    dest="$prefix/bin/crt"
    if [ -d "$dest" ] && [ ! -L "$dest" ]; then
        echo "Error: $dest is a directory." >&2; exit 1
    fi
    if [ ! -L "$dest" ] && [ "$self" = "$(realpath -m -- "$dest")" ]; then
        echo "crt: $dest is the running script"
    elif [ ! -L "$dest" ] && [ -f "$dest" ] && _same_content "$self" "$dest"; then
        echo "crt: $dest is up to date"
    else
        tmp="$prefix/bin/.crt.new.$$"
        if ! { cp -- "$self" "$tmp" && chown -- root:root "$tmp" && chmod 755 -- "$tmp" \
               && mv -fT -- "$tmp" "$dest"; }; then
            rm -f -- "$tmp"
            echo "Error: cannot install $dest" >&2; exit 1
        fi
        echo "crt: installed $dest"
    fi
    chown -- root:root "$dest" && chmod 755 -- "$dest" || exit 1

    link="$CRT_SYSROOT/usr/local/bin/crt"
    if [ -L "$link" ] && [ "$(readlink -- "$link")" = "$dest" ]; then
        echo "crt: $link already points to $dest"
    elif [ -d "$link" ] && [ ! -L "$link" ]; then
        echo "Error: $link is a directory." >&2; exit 1
    else
        if [ -e "$link" ] && [ ! -L "$link" ]; then echo "crt: replacing the copy at $link"; fi
        mkdir -p -- "$(dirname -- "$link")"
        ln -sfT -- "$dest" "$link"
        echo "crt: linked $link -> $dest"
    fi
}

user_entry() {  # user — prints "uid:gid:home" from the passwd database
    local line name uid gid home
    line=$(getent passwd "$1") || return 1
    IFS=: read -r name _ uid gid _ home _ <<< "$line"
    [ "$name" = "$1" ] && [[ "$uid" =~ ^[0-9]+$ ]] && [[ "$gid" =~ ^[0-9]+$ ]] || return 1
    printf '%s:%s:%s\n' "$uid" "$gid" "$home"
}

setup_user_home() {  # user uid gid dir
    local d="$4"
    if [ -L "$d" ] || { [ -e "$d" ] && [ ! -d "$d" ]; }; then
        echo "Error: $d exists and is not a directory." >&2; return 1
    fi
    if [ ! -d "$d" ]; then mkdir -m 700 -- "$d" || return 1; fi
    chown -- "$2:$3" "$d" && chmod 700 -- "$d" || return 1
    echo "crt: CRT_HOME for $1 is $d (owner $1, mode 700)"
}

warn_home_overlap() {  # user home crt_home
    local h c
    h=$(realpath -m -- "$2" 2>/dev/null) || return 0
    c=$(realpath -m -- "$3" 2>/dev/null) || return 0
    if _paths_overlap "$h" "$c"; then
        echo "Warning: $1's CRT_HOME $c overlaps their home directory $h," >&2
        echo "  so crt refuses hardened runs for $1. Give $1 a CRT_HOME outside $h." >&2
    fi
    return 0
}

cmd_setup() {
    local prefix="$CRT_DATA_PREFIX"
    local -a users=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --prefix)   [ $# -ge 2 ] || { echo "Error: --prefix requires a directory" >&2; exit 1; }
                        prefix="$2"; shift 2 ;;
            --prefix=*) prefix="${1#--prefix=}"; shift ;;
            -*) echo "Usage: crt setup [--prefix DIR] [user...]" >&2; exit 1 ;;
            *)  users+=("$1"); shift ;;
        esac
    done
    prefix=$(parse_prefix "$prefix") || exit 1
    require_root setup
    use_trusted_path

    if [ ${#users[@]} -eq 0 ]; then
        if [ -n "${SUDO_USER:-}" ]; then
            users=("$SUDO_USER")
        else
            echo "Error: run as 'sudo crt setup' or 'crt setup <user>...'" >&2
            exit 1
        fi
    fi

    # Resolve every user before changing anything.
    local -a uids=() gids=() homes=()
    local u entry uid gid home
    for u in "${users[@]}"; do
        if ! [[ "$u" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]]; then
            echo "Error: invalid user name '$u'" >&2; exit 1
        fi
        entry=$(user_entry "$u") || { echo "Error: unknown user '$u'" >&2; exit 1; }
        IFS=: read -r uid gid home <<< "$entry"
        uids+=("$uid"); gids+=("$gid"); homes+=("$home")
    done

    local layout=0
    if [ -d "$prefix" ]; then
        check_root_only_path "$prefix" \
            || { echo "  Fix it with: sudo crt install --prefix $prefix" >&2; exit 1; }
        make_root_dir "$prefix/home" || exit 1
        layout=1
    else
        echo "crt: no $prefix, so CRT_HOME stays $CRT_DEFAULT_HOME ('sudo crt install' creates the layout)"
    fi

    local i crt_home
    enable_root_controllers
    for i in "${!users[@]}"; do
        u=${users[i]}
        delegate_user_cgroup "${uids[i]}" "${gids[i]}" || exit 1
        echo "crt: cgroup delegation active for $u (uid=${uids[i]})"
        crt_home=$CRT_DEFAULT_HOME
        if [ "$layout" = 1 ]; then
            crt_home="$prefix/home/$u"
            setup_user_home "$u" "${uids[i]}" "${gids[i]}" "$crt_home" || exit 1
        fi
        warn_home_overlap "$u" "${homes[i]}" "$crt_home"
    done

    # The cgroup tree does not survive a reboot; runit redoes the delegation.
    if [ -d "$CRT_SYSROOT/run/runit" ] || [ -f "$CRT_SYSROOT/etc/runit/1" ]; then
        for u in "${users[@]}"; do register_crt_user "$u"; done
        install_runit_service
    else
        echo "Warning: unrecognised init system — limits active now but won't survive reboot" >&2
        echo "  Add to your system startup (as root):" >&2
        printf '    printf '"'"'+memory +cpu\\n'"'"' >> /sys/fs/cgroup/cgroup.subtree_control\n' >&2
        for i in "${!users[@]}"; do
            echo "    mkdir -p /sys/fs/cgroup/user-${uids[i]}" >&2
            echo "    chown -R ${uids[i]}:${gids[i]} /sys/fs/cgroup/user-${uids[i]}" >&2
        done
    fi
}

enable_root_controllers() {
    printf '+memory +cpu\n' > "$CRT_SYSROOT/sys/fs/cgroup/cgroup.subtree_control" 2>/dev/null \
        || echo "Warning: could not enable controllers in root cgroup (requires cgroup v2)" >&2
}

# delegate_user_cgroup uid gid — user-<uid> exists, belongs to the user, and
# passes memory+cpu to its children. It must hold no processes itself; callers
# live in a leaf (crt cgroup-exec) and crt runs in sibling crt-<pid> cgroups.
delegate_user_cgroup() {
    local ucg="$CRT_SYSROOT/sys/fs/cgroup/user-$1"
    if [ -L "$ucg" ]; then echo "Error: $ucg is a symlink." >&2; return 1; fi
    mkdir -p -- "$ucg" && chown -R -- "$1:$2" "$ucg" || return 1
    printf '+memory +cpu\n' > "$ucg/cgroup.subtree_control" 2>/dev/null \
        || echo "Warning: could not enable memory/cpu below user-$1 (does it hold processes itself?)" >&2
    return 0
}

# crt cgroup-exec USER [--leaf NAME] -- CMD...: as root, move into
# user-<uid>/<leaf> (owned by the user) and exec CMD there. CMD starts as root
# and must drop privileges itself (chpst -u, su -l). Everything it starts can
# then move into its own crt-<pid> sibling, which is what crt run needs.
cmd_cgroup_exec() {
    local user="" leaf=session caller_path entry uid gid ucg leafdir
    local usage="Usage: crt cgroup-exec <user> [--leaf NAME] -- cmd [args...]"
    while [ $# -gt 0 ]; do
        case "$1" in
            --leaf)   [ $# -ge 2 ] || { echo "$usage" >&2; exit 1; }
                      leaf="$2"; shift 2 ;;
            --leaf=*) leaf="${1#--leaf=}"; shift ;;
            --) shift; break ;;
            -*) echo "$usage" >&2; exit 1 ;;
            *)  [ -z "$user" ] || { echo "$usage" >&2; exit 1; }
                user="$1"; shift ;;
        esac
    done
    if [ -z "$user" ] || [ $# -eq 0 ]; then echo "$usage" >&2; exit 1; fi
    if ! [[ "$user" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]]; then
        echo "Error: invalid user name '$user'" >&2; exit 1
    fi
    if ! [[ "$leaf" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || [[ "$leaf" == crt-* ]]; then
        echo "Error: invalid leaf '$leaf' (letters, digits, '.', '_', '-'; not crt-*)" >&2
        exit 1
    fi
    require_root cgroup-exec
    caller_path=$PATH
    use_trusted_path

    entry=$(user_entry "$user") || { echo "Error: unknown user '$user'" >&2; exit 1; }
    IFS=: read -r uid gid _ <<< "$entry"
    if [ ! -f "$CRT_SYSROOT/sys/fs/cgroup/cgroup.controllers" ]; then
        echo "Error: cgroup v2 is not mounted at /sys/fs/cgroup" >&2; exit 1
    fi
    enable_root_controllers
    delegate_user_cgroup "$uid" "$gid" || exit 1

    ucg="$CRT_SYSROOT/sys/fs/cgroup/user-$uid"
    leafdir="$ucg/$leaf"
    if [ -L "$leafdir" ]; then echo "Error: $leafdir is a symlink." >&2; exit 1; fi
    mkdir -p -- "$leafdir" && chown -R -- "$uid:$gid" "$leafdir" || exit 1
    if ! printf '%s\n' "$$" > "$leafdir/cgroup.procs"; then
        echo "Error: cannot move into $leafdir" >&2; exit 1
    fi
    export PATH="$caller_path"
    exec -- "$@"
}

register_crt_user() {  # user — one name per line in /etc/crt-users
    local users_file="$CRT_SYSROOT/etc/crt-users"
    if ! grep -qxF -- "$1" "$users_file" 2>/dev/null; then
        printf '%s\n' "$1" >> "$users_file"
        echo "crt: added '$1' to /etc/crt-users"
    fi
}

install_runit_service() {
    local sv_dir="$CRT_SYSROOT/etc/sv/crt-cgroup"
    local service_dir="$CRT_SYSROOT/var/service"

    mkdir -p "$sv_dir"
    cat > "$sv_dir/run" << 'RUNEOF'
#!/bin/sh
exec 2>&1
while IFS= read -r entry; do
    uid=$(id -u "$entry" 2>/dev/null) || { echo "crt-cgroup: unknown user $entry"; continue; }
    gid=$(id -g "$entry" 2>/dev/null) || continue
    cg="/sys/fs/cgroup/user-${uid}"
    mkdir -p "$cg"
    printf '+memory +cpu\n' > /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null || true
    chown -R "${uid}:${gid}" "$cg"
    echo "crt-cgroup: delegated cgroup for ${entry} (${uid})"
done < /etc/crt-users 2>/dev/null || true
exec sleep infinity
RUNEOF
    chmod +x "$sv_dir/run"

    # Enable service (symlink into active service directory)
    if [ ! -L "$service_dir/crt-cgroup" ]; then
        ln -s "$sv_dir" "$service_dir/crt-cgroup"
        echo "crt: runit service installed at $service_dir/crt-cgroup"
    else
        sv restart crt-cgroup 2>/dev/null || true
        echo "crt: runit service restarted"
    fi
}

_doc_fail=0
_doc_warn=0
doctor_line() {  # level text
    case "$1" in
        FAIL) _doc_fail=$((_doc_fail + 1)) ;;
        warn) _doc_warn=$((_doc_warn + 1)) ;;
    esac
    printf '%-5s %s\n' "$1" "$2"
}

doctor_crt_home() {  # uid user
    local home_real parent owner mode c clear=1
    local -a exposures=()
    doctor_line info "CRT_HOME $CRT_HOME (from $CRT_HOME_FROM)"
    home_real=$(realpath -m -- "$CRT_HOME")
    if [ -d "$home_real" ]; then
        read -r owner mode < <(stat -c '%u %a' -- "$home_real")
        if [ "$owner" != "$1" ]; then
            doctor_line FAIL "CRT_HOME is owned by uid $owner, not by you (uid $1)"
        elif (( 8#$mode & 8#022 )); then
            doctor_line FAIL "CRT_HOME is writable by group or other (mode $mode): chmod 700 $home_real"
        else
            doctor_line ok "CRT_HOME is yours, mode $mode"
        fi
    else
        parent=$(dirname -- "$home_real")
        if [ -w "$parent" ]; then
            doctor_line ok "CRT_HOME does not exist yet; crt create makes it"
        else
            doctor_line FAIL "CRT_HOME does not exist and $parent is not writable: sudo crt setup $2"
        fi
    fi
    mapfile -t exposures < <(crt_home_exposures)
    for c in "${exposures[@]}"; do
        if _paths_overlap "$home_real" "${c%%|*}"; then
            doctor_line FAIL "CRT_HOME overlaps ${c#*|} (${c%%|*}): hardened runs are refused"
            clear=0
        fi
    done
    if [ "$clear" = 1 ]; then
        doctor_line ok "CRT_HOME is outside \$HOME, /tmp and every config mount source"
    fi
}

doctor_userns() {
    local us f
    if ! us=$(find_unshare); then
        doctor_line FAIL "unshare not found in /usr/bin, /bin, /usr/sbin or /sbin"
    elif "$us" --user --map-root-user --mount --pid -f true >/dev/null 2>&1; then
        doctor_line ok "unprivileged user namespaces work"
    else
        doctor_line FAIL "unprivileged user namespaces do not work (unshare --user failed)"
        for f in /proc/sys/kernel/unprivileged_userns_clone /proc/sys/user/max_user_namespaces; do
            if [ -r "$f" ]; then doctor_line info "  $f = $(< "$f")"; fi
        done
    fi
}

# doctor_cgroup uid user level — probes what apply_cgroup needs: a delegated
# user-<uid> cgroup with the memory controller, where this user can create a
# child, set memory.max and move a process in.
doctor_cgroup() {
    local uid="$1" user="$2" lvl="$3"
    local cgroot="$CRT_SYSROOT/sys/fs/cgroup"
    local ucg="$cgroot/user-$uid" probe why=""
    if [ ! -f "$cgroot/cgroup.controllers" ]; then
        doctor_line "$lvl" "cgroup v2 is not mounted at /sys/fs/cgroup: no memory/cpu limits"
        return 0
    fi
    if [ ! -d "$ucg" ]; then
        doctor_line "$lvl" "no cgroup delegated to you (/sys/fs/cgroup/user-$uid): sudo crt setup $user"
        return 0
    fi
    if [ ! -w "$ucg" ] || [ ! -w "$ucg/cgroup.procs" ]; then
        doctor_line "$lvl" "/sys/fs/cgroup/user-$uid is not writable by you: sudo crt setup $user"
        return 0
    fi
    doctor_line ok "cgroup delegated: /sys/fs/cgroup/user-$uid"
    if ! grep -qw memory "$ucg/cgroup.controllers" 2>/dev/null; then
        doctor_line "$lvl" "the memory controller is not enabled for user-$uid: sudo crt setup $user"
        return 0
    fi
    printf '+memory +cpu\n' > "$ucg/cgroup.subtree_control" 2>/dev/null || true
    probe="$ucg/crt-doctor-$$"
    if ! mkdir "$probe" 2>/dev/null; then
        doctor_line "$lvl" "cannot create a child cgroup in user-$uid"
        return 0
    fi
    if ! printf '%s\n' 67108864 > "$probe/memory.max" 2>/dev/null; then
        why="cannot set memory.max in a child of user-$uid"
    elif ! ( printf '%s\n' "$BASHPID" > "$probe/cgroup.procs" ) 2>/dev/null; then
        why="cannot move a process into user-$uid: moving one needs write access to the"
        why+=" cgroup.procs of the common ancestor, so crt must start from inside user-$uid"
        why+=" (start the caller with: sudo crt cgroup-exec $user -- ...)"
    fi
    rmdir "$probe" 2>/dev/null || { [ -z "$CRT_TEST_MOCKS" ] || rm -rf -- "$probe"; }
    if [ -z "$why" ]; then
        doctor_line ok "memory limits work: set memory.max and joined a child cgroup"
    else
        doctor_line "$lvl" "$why"
    fi
}

cmd_doctor() {
    local limits=0 uid user self
    while [ $# -gt 0 ]; do
        case "$1" in
            --limits) limits=1; shift ;;
            *) echo "Usage: crt doctor [--limits]" >&2; exit 1 ;;
        esac
    done
    uid=$(id -u)
    user=$(id -un 2>/dev/null) || user="uid-$uid"
    self=$(realpath -e -- "${BASH_SOURCE[0]}" 2>/dev/null) || self=$0

    doctor_line info "crt $self, user $user (uid $uid)"
    doctor_crt_home "$uid" "$user"
    doctor_userns
    if [ "$limits" = 1 ]; then doctor_cgroup "$uid" "$user" FAIL
    else doctor_cgroup "$uid" "$user" warn; fi

    if [ "$_doc_fail" -gt 0 ]; then
        echo "doctor: $_doc_fail problem(s), $_doc_warn warning(s)"
        exit 1
    fi
    echo "doctor: ready for hardened runs, $_doc_warn warning(s)"
}

cmd_help() {
    cat << 'EOF'
crt - minimal chroot manager

Usage:
  crt create <name>               Bootstrap Void Linux rootfs (xbps)
  crt create <name> [image]       Pull rootfs from OCI registry
  crt enter <name>                Interactive shell
  crt run [opts] <name> <cmd...>  Run command in isolated environment
  crt list                        List chroots
  crt rm <name>                   Remove chroot
  crt export <name> <binary>      Create host wrapper for binary
  crt install [--prefix DIR]      Install crt as DIR/bin/crt (root), link /usr/local/bin/crt
  crt setup [--prefix DIR] [user...]
                                  Delegate a cgroup and make DIR/home/<user> (root)
  crt doctor [--limits]           Check this user's readiness for hardened runs
  crt home                        Print the resolved CRT_HOME
  crt cgroup-exec <user> [--leaf NAME] -- cmd...
                                  (root) Run cmd in user-<uid>/NAME (default
                                  session) so crt run can apply memory/cpu limits

run options (flags override the stored config):
  -v, --volume h:c[:ro]   Bind mount host->container; :ro makes it read-only
  -e, --env NAME[=val]    Set env var; NAME alone passes the caller's value through
  -m, --memory SIZE       Memory limit (e.g. 256M, 2G)
  -c, --cpus FLOAT        CPU limit (e.g. 1.5)
      --net none|host     Network: none = new net namespace, loopback only (default host)
      --no-home           Do not bind $HOME into the container
      --tmp private|host  /tmp: private tmpfs, or the host /tmp bind (default host)
      --clean-env         Start from an empty env plus a minimal PATH and HOME
      --ro-root           Mount the rootfs read-only
      --keep-fd N         Keep fd N open in the command (repeatable)

Any isolation option turns on hardened mode: setup fails closed (a step that
cannot be enforced aborts the run), the host root is detached after pivot_root,
and the command runs with all capabilities dropped (no_new_privs), so it cannot
remount, unmount, or create mounts. A minimal /dev (null, zero, full, random,
urandom, tty, a fresh devpts, private shm) is built; the host /dev is never
exposed. File descriptors above stderr are closed except --keep-fd entries and,
when -e NODE_CHANNEL_FD is passed, that fd (so Node's IPC channel works).

Hardened mode protects the host from the workload in a hardened run. Default
mode is NOT a sandbox: a default run has your authority over the host and can
change any rootfs, config or marker under CRT_HOME. Never run untrusted code in
default mode, in any rootfs; every hardened rootfs depends on that.

Hardened mode trusts the rootfs's own umount/setpriv, so it runs only on a
pristine rootfs: crt create writes a marker (CRT_HOME/.state/<name>.pristine,
keyed on the rootfs's path and inode), any non-hardened run deletes it, and a
hardened run requires it and forces the rootfs read-only. Recreate a rootfs
with crt rm then crt create, never by hand. Stored config lives outside every
rootfs (CRT_HOME/.config/<name>). CRT_HOME must be outside $HOME, /tmp and any
mount source in a stored config (the default /home/crt is), and a hardened run
may not bind CRT_HOME, .config or .state (rw or ro), or it is refused.
Names: letters, digits, '.', '_', '-', starting alphanumeric.

Install layout (DIR defaults to /data/crt):
  DIR/             root, 755
  DIR/bin/crt      the installed script, root, 755; /usr/local/bin/crt links to it
  DIR/home/<user>  that user's CRT_HOME, owned by the user, 700
  One-time host setup: sudo ./crt install; sudo crt setup <user>...
  Memory/cpu limits need the caller inside user-<uid>. In a runit run script:
    exec crt cgroup-exec s-ci --leaf NAME -- chpst -u s-ci cmd...
  For a login shell: sudo crt cgroup-exec <user> -- su -l <user>
  crt doctor reports the resolved CRT_HOME, its placement, user namespaces and
  the cgroup; it exits 1 on anything that blocks hardened runs (with --limits,
  also on missing memory limits).

Environment:
  CRT_HOME    Where chroots are stored: $CRT_HOME if set, else
              /data/crt/home/<user> if it exists, else /home/crt
  CRT_BIN     Where wrappers are created (default: $CRT_HOME/bin under
              /data/crt, else /home/crt/bin)
  VOID_REPO   Void Linux package repo (default: https://repo-default.voidlinux.org/current)

Runtime deps:
  xbps-install       required for: crt create <name> and the packages directive
  curl jq tar        required for: crt create <name> <image>
  unshare pivot_root chroot  required for: crt run / crt enter

Examples:
  crt create void-env
  crt create ubuntu ubuntu:22.04
  crt create alpine ghcr.io/library/alpine:3.19
  crt run ubuntu apt install -y perl python3
  crt run --net none --no-home --tmp private --clean-env sandbox node script.js
  crt export ubuntu perl
  crt enter ubuntu
EOF
}

CRT_TEST_MOCKS=$(crt_test_mocks) || CRT_TEST_MOCKS=""
CRT_SYSROOT=""
if [ -n "$CRT_TEST_MOCKS" ]; then CRT_SYSROOT=${CRT_TEST_SYSROOT:-}; fi
CRT_DATA_PREFIX="$CRT_SYSROOT/data/crt"
readonly CRT_TEST_MOCKS CRT_SYSROOT CRT_DATA_PREFIX
resolve_crt_home

# Main dispatch
case "${1:-}" in
    create) shift; cmd_create "$@" ;;
    enter)  shift; cmd_enter "$@" ;;
    run)    shift; cmd_run "$@" ;;
    list|ls) cmd_list ;;
    rm|remove) shift; cmd_rm "$@" ;;
    export) shift; cmd_export "$@" ;;
    install) shift; cmd_install "$@" ;;
    setup)  shift; cmd_setup "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    cgroup-exec) shift; cmd_cgroup_exec "$@" ;;
    home)   printf '%s\n' "$CRT_HOME" ;;
    help|--help|-h) cmd_help ;;
    *)
        cmd_help
        exit 1
        ;;
esac
