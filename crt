#!/bin/bash
# crt - minimal chroot manager
#
# Usage:
#   crt create <name>               # Bootstrap Void Linux rootfs via xbps
#   crt create <name> [image]       # Pull rootfs from OCI registry
#   crt enter <name>                # Interactive shell
#   crt run <name> <cmd> [args...]  # Run command (isolated via unshare+chroot)
#   crt list                        # List chroots
#   crt rm <name>                   # Remove chroot
#   crt export <name> <binary>      # Create host wrapper for binary

set -e

CRT_HOME="${CRT_HOME:-/home/crt}"
CRT_BIN="${CRT_BIN:-/home/crt/bin}"

parse_image_ref() {
    local input="$1"
    local registry repo tag

    # Extract tag: only if colon appears in the last path segment (after last slash)
    local last_seg="${input##*/}"
    if [[ "$last_seg" == *:* ]]; then
        tag="${last_seg##*:}"
        input="${input%:"${tag}"}"
    else
        tag="latest"
    fi

    # Extract registry: first component is a hostname if it contains '.' or ':'
    local first="${input%%/*}"
    if [[ "$input" == */* ]] && [[ "$first" == *.* || "$first" == *:* ]]; then
        registry="$first"
        repo="${input#*/}"
    elif [[ "$input" == */* ]]; then
        registry="registry-1.docker.io"
        repo="$input"
    else
        registry="registry-1.docker.io"
        repo="library/$input"
    fi

    echo "$registry" "$repo" "$tag"
}

oci_token() {
    local registry="$1"
    local repo="$2"
    local url token

    case "$registry" in
        registry-1.docker.io)
            url="https://auth.docker.io/token?service=registry.docker.io&scope=repository:${repo}:pull" ;;
        ghcr.io)
            url="https://ghcr.io/token?scope=repository:${repo}:pull" ;;
        quay.io)
            url="https://quay.io/v2/auth?service=quay.io&scope=repository:${repo}:pull" ;;
        *)
            url="https://${registry}/v2/auth?scope=repository:${repo}:pull" ;;
    esac

    token=$(curl -fsSL "$url" | jq -r '.token // .access_token') || {
        echo "Error: failed to fetch OCI token from $registry" >&2
        return 1
    }
    if [[ -z "$token" || "$token" == "null" ]]; then
        echo "Error: no token returned from $registry for $repo" >&2
        return 1
    fi
    echo "$token"
}

oci_manifest() {
    local registry="$1"
    local repo="$2"
    local tag="$3"
    local token="$4"
    local api_base="https://${registry}/v2/${repo}"
    local arch

    case "$(uname -m)" in
        x86_64)  arch="amd64" ;;
        aarch64) arch="arm64" ;;
        armv7l)  arch="arm" ;;
        *)       arch="$(uname -m)" ;;
    esac

    local manifest
    manifest=$(curl -fsSL \
        -H "Authorization: Bearer $token" \
        -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
        -H "Accept: application/vnd.oci.image.manifest.v1+json" \
        -H "Accept: application/vnd.docker.distribution.manifest.list.v2+json" \
        -H "Accept: application/vnd.oci.image.index.v1+json" \
        "${api_base}/manifests/${tag}") || {
        echo "Error: failed to fetch manifest for ${registry}/${repo}:${tag}" >&2
        return 1
    }

    # Detect image index: check mediaType field OR presence of .manifests array
    local is_index
    is_index=$(echo "$manifest" | jq -r '
        if (.mediaType // "" | test("index|list")) or (.manifests != null) then "yes" else "" end
    ')
    if [ "$is_index" = "yes" ]; then
        local digest
        digest=$(echo "$manifest" | jq -r \
            --arg arch "$arch" \
            '.manifests[] | select(.platform.architecture == $arch) | .digest' \
            | head -1)
        if [ -z "$digest" ]; then
            echo "Error: no manifest found for arch $arch in ${registry}/${repo}:${tag}" >&2
            return 1
        fi
        manifest=$(curl -fsSL \
            -H "Authorization: Bearer $token" \
            -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
            -H "Accept: application/vnd.oci.image.manifest.v1+json" \
            "${api_base}/manifests/${digest}") || {
            echo "Error: failed to fetch platform manifest ${digest}" >&2
            return 1
        }
    fi

    echo "$manifest"
}

oci_unpack() {
    local registry="$1"
    local repo="$2"
    local token="$3"
    local manifest="$4"
    local rootfs="$5"
    local api_base="https://${registry}/v2/${repo}"

    local layers
    layers=$(echo "$manifest" | jq -r '.layers[].digest')

    local cache_dir="$CRT_HOME/.cache/layers"
    mkdir -p "$cache_dir"

    local digest
    for digest in $layers; do
        local blob="$cache_dir/${digest//:/-}"
        echo "  layer ${digest:7:12}..."

        # Ensure blob is cached
        if [ ! -f "$blob" ]; then
            local blob_tmp="${blob}.tmp"
            curl -fsSL \
                -H "Authorization: Bearer $token" \
                "${api_base}/blobs/${digest}" \
                -o "$blob_tmp" || {
                rm -f "$blob_tmp"
                echo "Error: failed to download layer ${digest:7:12}" >&2
                return 1
            }
            mv "$blob_tmp" "$blob"
        fi

        # Apply whiteouts from this layer's tar listing BEFORE extracting,
        # so we only delete lower-layer content, not the current layer's files.
        while IFS= read -r wh_path; do
            wh_path="${wh_path#./}"
            local wh_dir wh_name target
            wh_dir="$(dirname "$wh_path")"
            wh_name="$(basename "$wh_path")"
            target="$rootfs/$wh_dir"
            if [ "$wh_name" = ".wh..wh..opq" ]; then
                find "${target:?}" -mindepth 1 -delete 2>/dev/null || true
            else
                rm -rf "${target:?}/${wh_name#.wh.}"
            fi
        done < <(tar -tzf "$blob" 2>/dev/null | grep '\.wh\.' || true)

        # Extract layer; remove whiteout markers (they've been applied above)
        tar -xzf "$blob" -C "$rootfs" 2>/dev/null || {
            echo "Error: failed to unpack layer ${digest:7:12}" >&2
            return 1
        }
        find "$rootfs" -name '.wh.*' -delete
    done
}

parse_memory() {
    local val="$1"
    if [ -z "$val" ]; then
        echo "Error: parse_memory requires a value" >&2
        return 1
    fi
    local num="${val%[GgMmKk]}"
    if ! [[ "$num" =~ ^[0-9]+$ ]]; then
        echo "Error: invalid memory value '$val'" >&2
        return 1
    fi
    case "${val: -1}" in
        G|g) echo $(( num * 1024 * 1024 * 1024 )) ;;
        M|m) echo $(( num * 1024 * 1024 )) ;;
        K|k) echo $(( num * 1024 )) ;;
        *)   echo "$num" ;;
    esac
}

read_config() {
    local config_file="$1"
    config_image=""
    config_mounts=()
    config_envs=()
    config_memory=""
    config_cpus=""

    [ -f "$config_file" ] || return 0

    local key val
    while read -r key val; do
        case "$key" in
            '#'*|'') continue ;;
        esac
        if [ -z "$val" ]; then
            echo "Warning: config directive '$key' has no value, skipping" >&2
            continue
        fi
        case "$key" in
            image)   config_image="$val" ;;
            mount)   config_mounts+=("$val") ;;
            env)     config_envs+=("$val") ;;
            memory)  config_memory="$val" ;;
            cpus)    config_cpus="$val" ;;
        esac
    done < "$config_file"
}

write_config() {
    local config_file="$1"
    local image="$2"
    printf 'image %s\n' "$image" > "$config_file"
}

apply_cgroup() {
    local memory="$1"
    local cpus="$2"

    [ -z "$memory" ] && [ -z "$cpus" ] && return 0

    if [ ! -f /sys/fs/cgroup/cgroup.controllers ]; then
        echo "Warning: cgroup v2 not available, resource limits not applied" >&2
        return 0
    fi

    local user_cg="/sys/fs/cgroup/user-$(id -u)"
    if [ ! -d "$user_cg" ]; then
        echo "Warning: cgroup not delegated for your user, resource limits not applied" >&2
        echo "  Run 'sudo crt setup' to enable memory/cpu limits." >&2
        return 0
    fi

    # Enable controllers in user's cgroup subtree (idempotent)
    echo "+memory +cpu" > "$user_cg/cgroup.subtree_control" 2>/dev/null || true

    local cg="$user_cg/crt-$$"
    if ! mkdir -p "$cg" 2>/dev/null; then
        echo "Warning: cannot create cgroup $cg, resource limits not applied" >&2
        return 0
    fi

    if ! echo $$ > "$cg/cgroup.procs" 2>/dev/null; then
        echo "Warning: cannot join cgroup, resource limits not applied" >&2
        rmdir "$cg" 2>/dev/null
        return 0
    fi

    # Record path for cleanup after unshare exits
    _CRT_CGROUP="$cg"

    if [ -n "$memory" ]; then
        local mem_bytes
        mem_bytes=$(parse_memory "$memory" 2>/dev/null) || {
            echo "Warning: invalid memory value '$memory', skipping" >&2
            mem_bytes=""
        }
        if [ -n "$mem_bytes" ]; then
            echo "$mem_bytes" > "$cg/memory.max" \
                || echo "Warning: failed to set memory limit to $memory" >&2
        fi
    fi

    if [ -n "$cpus" ]; then
        local quota
        quota=$(awk -v cpus="$cpus" 'BEGIN { printf "%d", cpus * 100000 }')
        echo "$quota 100000" > "$cg/cpu.max" \
            || echo "Warning: failed to set CPU limit to $cpus" >&2
    fi
}

_create_xbps() {
    local rootfs="$1"
    local repo="${VOID_REPO:-https://repo-default.voidlinux.org/current}"

    if ! command -v xbps-install >/dev/null 2>&1; then
        echo "Error: xbps-install not found. Install xbps or pass an OCI image name." >&2
        return 1
    fi

    echo "Bootstrapping Void Linux via xbps..."
    xbps-install -r "$rootfs" --repository="$repo" -y base-minimal
}

_create_oci() {
    local image="$1"
    local rootfs="$2"

    for dep in curl jq tar; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            echo "Error: '$dep' is required for OCI image pull" >&2
            return 1
        fi
    done

    echo "Pulling OCI image '$image'..."

    local registry repo tag
    read -r registry repo tag <<< "$(parse_image_ref "$image")"

    local token manifest
    token=$(oci_token "$registry" "$repo")
    manifest=$(oci_manifest "$registry" "$repo" "$tag" "$token")
    oci_unpack "$registry" "$repo" "$token" "$manifest" "$rootfs"
}

cmd_create() {
    local name="$1"
    local arg="${2:-}"

    if [ -z "$name" ]; then
        echo "Usage: crt create <name> [image|config-file]"
        echo "  no second arg:   bootstrap Void Linux via xbps"
        echo "  image reference: pull from OCI registry (e.g. ubuntu:22.04)"
        echo "  config file:     read directives from file (image, mount, env, memory, cpus)"
        exit 1
    fi

    local rootfs="$CRT_HOME/$name"

    if [ -d "$rootfs" ]; then
        echo "Chroot '$name' already exists at $rootfs"
        exit 1
    fi

    mkdir -p "$rootfs"
    trap 'rm -rf "$rootfs"' ERR

    local stored_config="$CRT_HOME/$name/config"

    if [ -z "$arg" ]; then
        _create_xbps "$rootfs"
        write_config "$stored_config" "void"
    elif [ -f "$arg" ]; then
        local config_image="" config_memory="" config_cpus=""
        local -a config_mounts=() config_envs=()
        read_config "$arg"
        if [ -z "$config_image" ] || [ "$config_image" = "void" ]; then
            _create_xbps "$rootfs"
        else
            _create_oci "$config_image" "$rootfs"
        fi
        cp "$arg" "$stored_config"
    else
        _create_oci "$arg" "$rootfs"
        write_config "$stored_config" "$arg"
    fi

    trap - ERR
    echo "Created: $rootfs ($(du -sh "$rootfs" 2>/dev/null | cut -f1))"
}

cmd_enter() {
    if [ -z "${1:-}" ]; then
        echo "Usage: crt enter <name>"
        exit 1
    fi
    cmd_run "$1" /bin/bash -l
}

cmd_run() {
    OPTIND=1
    local opt
    local -a flag_mounts=() flag_envs=()
    local flag_memory="" flag_cpus=""

    while getopts ':v:e:m:c:' opt; do
        case "$opt" in
            v) flag_mounts+=("$OPTARG") ;;
            e) flag_envs+=("$OPTARG") ;;
            m) flag_memory="$OPTARG" ;;
            c) flag_cpus="$OPTARG" ;;
            :) echo "Error: -$OPTARG requires an argument" >&2; exit 1 ;;
            ?) echo "Error: unknown option -$OPTARG" >&2; exit 1 ;;
        esac
    done
    shift $((OPTIND - 1))

    local name="$1"
    shift

    if [ -z "$name" ]; then
        echo "Usage: crt run [-v host:container] [-e KEY=val] [-m SIZE] [-c FLOAT] <name> [cmd...]"
        exit 1
    fi

    local rootfs="$CRT_HOME/$name"

    if [ ! -d "$rootfs/bin" ]; then
        echo "Error: Chroot '$name' not found" >&2
        echo "Run: crt create $name" >&2
        exit 1
    fi

    # Load stored config
    local config_image="" config_memory="" config_cpus=""
    local -a config_mounts=() config_envs=()
    read_config "$CRT_HOME/$name/config"

    # Merge: config first, flags override/extend
    local -a all_mounts=("${config_mounts[@]}" "${flag_mounts[@]}")
    local -a all_envs=("${config_envs[@]}" "${flag_envs[@]}")
    local memory="${flag_memory:-$config_memory}"
    local cpus="${flag_cpus:-$config_cpus}"

    # Validate mount specs
    local spec
    for spec in "${all_mounts[@]}"; do
        if [[ "$spec" != *:* ]]; then
            echo "Error: mount '$spec' must be host:container" >&2
            exit 1
        fi
    done

    # Apply env vars (inherited through exec unshare automatically)
    local env_spec
    for env_spec in "${all_envs[@]}"; do
        export "$env_spec"
    done

    # Apply cgroup limits before exec
    _CRT_CGROUP=""
    apply_cgroup "$memory" "$cpus"

    [ $# -eq 0 ] && set -- /bin/bash -l

    local workdir
    workdir="$(pwd)"

    # shellcheck disable=SC2016
    unshare --user --map-root-user --mount --pid --uts --ipc -f \
        /bin/bash -c '
            rootfs=$1; userhome=$2; workdir=$3; nmounts=$4; shift 4
            mkdir -p "$rootfs/proc" "$rootfs/sys" "$rootfs/dev/pts" "$rootfs/tmp" "$rootfs/etc"
            touch "$rootfs/etc/resolv.conf"
            mount -t proc proc "$rootfs/proc"
            mount -t sysfs sysfs "$rootfs/sys"
            mount --bind /dev "$rootfs/dev"
            mount --bind /dev/pts "$rootfs/dev/pts"
            mount --bind /etc/resolv.conf "$rootfs/etc/resolv.conf"
            mkdir -p "$rootfs$userhome"
            mount --bind "$userhome" "$rootfs$userhome"
            mount --bind /tmp "$rootfs/tmp"
            i=0
            while [ "$i" -lt "$nmounts" ]; do
                spec=$1; shift; i=$((i+1))
                host="${spec%%:*}"; container="${spec#*:}"
                mkdir -p "$rootfs$container"
                mount --bind "$host" "$rootfs$container"
            done
            exec chroot "$rootfs" /bin/sh -c \
                '"'"'cd "$1" 2>/dev/null || cd /; shift; exec "$@"'"'"' -- "$workdir" "$@"
        ' -- "$rootfs" "$HOME" "$workdir" "${#all_mounts[@]}" "${all_mounts[@]}" "$@"
    local _rc
    _rc=$?
    [ -n "${_CRT_CGROUP:-}" ] && rmdir "$_CRT_CGROUP" 2>/dev/null || true
    exit "$_rc"
}

cmd_list() {
    if [ ! -d "$CRT_HOME" ]; then
        echo "No chroots found in $CRT_HOME"
        exit 0
    fi

    echo "NAME            SIZE      PATH"
    for dir in "$CRT_HOME"/*/; do
        [ -d "$dir" ] || continue
        local name size
        name=$(basename "$dir")
        size=$(du -sh "$dir" 2>/dev/null | cut -f1)
        printf "%-15s %-9s %s\n" "$name" "$size" "$dir"
    done
}

cmd_rm() {
    local name="$1"

    if [ -z "$name" ]; then
        echo "Usage: crt rm <name>"
        exit 1
    fi

    local rootfs="$CRT_HOME/$name"

    if [ ! -d "$rootfs" ]; then
        echo "Error: Chroot '$name' not found"
        exit 1
    fi

    echo "Removing $rootfs..."
    rm -rf "$rootfs"
    echo "Removed chroot '$name'"
}

cmd_export() {
    local name="$1"
    local binary="$2"
    local wrapper_name="${3:-$(basename "$binary")}"

    if [ -z "$name" ] || [ -z "$binary" ]; then
        echo "Usage: crt export <name> <binary> [wrapper-name]"
        echo ""
        echo "Examples:"
        echo "  crt export ubuntu perl"
        echo "  crt export ubuntu /usr/bin/python3 python"
        exit 1
    fi

    local rootfs="$CRT_HOME/$name"

    if [ ! -d "$rootfs/bin" ]; then
        echo "Error: Chroot '$name' not found"
        exit 1
    fi

    # Find the binary in the chroot
    local bin_path=""
    if [[ "$binary" == /* ]]; then
        bin_path="$binary"
    else
        # Search common paths
        for p in /usr/bin /bin /usr/local/bin /usr/sbin /sbin; do
            if [ -f "$rootfs$p/$binary" ]; then
                bin_path="$p/$binary"
                break
            fi
        done
    fi

    if [ -z "$bin_path" ] || [ ! -f "$rootfs$bin_path" ]; then
        echo "Error: Binary '$binary' not found in chroot '$name'"
        exit 1
    fi

    mkdir -p "$CRT_BIN"

    local wrapper="$CRT_BIN/$wrapper_name"
    local self_path
    self_path="$(realpath "$0")"

    cat > "$wrapper" << EOF
#!/bin/bash
# crt wrapper for $bin_path from $name
exec "$self_path" run "$name" "$bin_path" "\$@"
EOF

    chmod +x "$wrapper"
    echo "Exported: $wrapper -> $name:$bin_path"
}

cmd_setup() {
    # Must run as root (directly or via sudo)
    if [ "$(id -u)" -ne 0 ]; then
        echo "Error: 'crt setup' must run as root." >&2
        echo "  Try: sudo crt setup" >&2
        exit 1
    fi

    # Determine the target user
    local target_uid target_gid target_user
    if [ -n "${SUDO_UID:-}" ]; then
        # Invoked via sudo — set up for the invoking user
        target_uid="$SUDO_UID"
        target_gid="${SUDO_GID:-$SUDO_UID}"
        target_user="${SUDO_USER:-uid-$SUDO_UID}"
    elif [ -n "${1:-}" ]; then
        # Username passed explicitly (e.g. root running: crt setup alice)
        target_uid=$(id -u "$1" 2>/dev/null) || {
            echo "Error: unknown user '$1'" >&2
            exit 1
        }
        target_gid=$(id -g "$1") || {
            echo "Error: cannot get gid for '$1'" >&2
            exit 1
        }
        target_user="$1"
    else
        echo "Error: run as 'sudo crt setup' or 'crt setup <username>'" >&2
        exit 1
    fi

    # 1. Immediate cgroup delegation
    printf '+memory +cpu\n' > /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null || {
        echo "Warning: could not enable controllers in root cgroup (requires cgroup v2)" >&2
    }
    local cg="/sys/fs/cgroup/user-${target_uid}"
    mkdir -p "$cg"
    chown -R "${target_uid}:${target_gid}" "$cg"
    echo "crt: cgroup delegation active for $target_user (uid=$target_uid)"

    # 2. Install boot-time persistence
    local init_system="unknown"
    { [ -d /run/runit ] || [ -f /etc/runit/1 ]; } && init_system="runit"

    case "$init_system" in
        runit)
            _setup_runit "$target_uid" "$target_gid" "$target_user"
            ;;
        *)
            echo "Warning: unrecognised init system — limits active now but won't survive reboot" >&2
            echo "  Add to your system startup (as root):" >&2
            printf '    printf '"'"'+memory +cpu\\n'"'"' >> /sys/fs/cgroup/cgroup.subtree_control\n' >&2
            echo "    mkdir -p /sys/fs/cgroup/user-${target_uid}" >&2
            echo "    chown -R ${target_uid}:${target_gid} /sys/fs/cgroup/user-${target_uid}" >&2
            ;;
    esac
}

_setup_runit() {
    local uid="$1"
    local gid="$2"
    local user="$3"

    local sv_dir="/etc/sv/crt-cgroup"
    local service_dir="/var/service"

    mkdir -p "$sv_dir"
    cat > "$sv_dir/run" << 'RUNEOF'
#!/bin/sh
exec 2>&1
while IFS= read -r entry; do
    uid=$(id -u "$entry" 2>/dev/null) || { echo "crt-cgroup: unknown user $entry"; continue; }
    gid=$(id -g "$entry" 2>/dev/null) || continue
    cg="/sys/fs/cgroup/user-${uid}"
    mkdir -p "$cg"
    printf '+memory +cpu\n' > /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null || true
    chown -R "${uid}:${gid}" "$cg"
    echo "crt-cgroup: delegated cgroup for ${entry} (${uid})"
done < /etc/crt-users 2>/dev/null || true
exec sleep infinity
RUNEOF
    chmod +x "$sv_dir/run"

    # Register user in /etc/crt-users (one username per line)
    if [[ ! "$user" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
        echo "Error: invalid username '$user'" >&2
        return 1
    fi
    if ! grep -qx "$user" /etc/crt-users 2>/dev/null; then
        echo "$user" >> /etc/crt-users
        echo "crt: added '$user' to /etc/crt-users"
    fi

    # Enable service (symlink into active service directory)
    if [ ! -L "$service_dir/crt-cgroup" ]; then
        ln -s "$sv_dir" "$service_dir/crt-cgroup"
        echo "crt: runit service installed at $service_dir/crt-cgroup"
    else
        sv restart crt-cgroup 2>/dev/null || true
        echo "crt: runit service restarted"
    fi
}

cmd_help() {
    cat << 'EOF'
crt - minimal chroot manager

Usage:
  crt create <name>               Bootstrap Void Linux rootfs (xbps)
  crt create <name> [image]       Pull rootfs from OCI registry
  crt enter <name>                Interactive shell
  crt run <name> <cmd> [args...]  Run command in isolated environment
  crt list                        List chroots
  crt rm <name>                   Remove chroot
  crt export <name> <binary>      Create host wrapper for binary
  crt setup                       Delegate cgroup to your user (run with sudo)

Environment:
  CRT_HOME    Where chroots are stored (default: /home/crt)
  CRT_BIN     Where wrappers are created (default: /home/crt/bin)
  VOID_REPO   Void Linux package repo (default: https://repo-default.voidlinux.org/current)

Runtime deps:
  xbps-install  required for: crt create <name>
  curl jq tar   required for: crt create <name> <image>
  unshare chroot  required for: crt run / crt enter

Examples:
  crt create void-env
  crt create ubuntu ubuntu:22.04
  crt create alpine ghcr.io/library/alpine:3.19
  crt run ubuntu apt install -y perl python3
  crt export ubuntu perl
  crt enter ubuntu
EOF
}

# Main dispatch
case "${1:-}" in
    create) shift; cmd_create "$@" ;;
    enter)  shift; cmd_enter "$@" ;;
    run)    shift; cmd_run "$@" ;;
    list|ls) cmd_list ;;
    rm|remove) shift; cmd_rm "$@" ;;
    export) shift; cmd_export "$@" ;;
    setup)  shift; cmd_setup "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
        cmd_help
        exit 1
        ;;
esac
